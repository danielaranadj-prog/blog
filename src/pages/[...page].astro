---
// Component Imports
import BaseHead from '../components/BaseHead.astro';
import BlogHeader from '../components/BlogHeader.astro';
import BlogPostPreview from '../components/BlogPostPreview.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';
import settings from '../data/site-settings.json';
import SiteAds from '../components/SiteAds.astro';

// --- MAGIA DE PAGINACIÓN (Astro) ---
export async function getStaticPaths({ paginate }) {
  let allPosts = await Astro.glob('./posts/*.md');
  allPosts = allPosts.sort(
    (a, b) => new Date(b.frontmatter.publishDate).valueOf() - new Date(a.frontmatter.publishDate).valueOf()
  );
  
  // El artículo más reciente siempre ocupa la cabecera.
  const featuredPost = allPosts[0];

  return paginate(allPosts, { 
    pageSize: 13,
    props: { featuredPost }
  });
}

const { page, featuredPost } = Astro.props;

// En página 1 mostramos el Hero Post y el resto en el grid
const isFirstPage = page.currentPage === 1;
const gridPosts = isFirstPage 
  ? page.data.filter((p) => p.url !== featuredPost.url)
  : page.data;

const title = settings.homeTitle;
const description = settings.description;
const permalink = Astro.url.href;

const featuredHeroImage = featuredPost.frontmatter.heroImage || featuredPost.frontmatter.heroImageLink || 'https://res.cloudinary.com/dbwdmu9k2/image/upload/v1769926152/DSCF3740_ava5eg.jpg';
const featuredData = `${featuredPost.frontmatter.title} ${(featuredPost.frontmatter.tags || []).join(' ')}`;
const featuredTag = /vallarta|oaxaca|méxico/i.test(featuredData) ? 'MÉXICO'
  : /argentina|patagonia|ushuaia|mendoza|buenos aires/i.test(featuredData) ? 'ARGENTINA'
  : /españa|madrid|barcelona|segovia/i.test(featuredData) ? 'ESPAÑA'
  : (featuredPost.frontmatter.tags?.[0] || 'VIAJES');
const featuredSearch = `${featuredData} ${featuredPost.frontmatter.description || ''} ${featuredPost.url}`;
---

<html lang="es">
    <head>
        <BaseHead {title} {description} {permalink} image={settings.assets.socialImage} />

        <style>
            .home-shell { max-width: 1440px; margin: auto; padding: 0 2rem 4rem; box-sizing: border-box; }
            .subbar-container { display: flex; align-items: center; gap: 2rem; padding: 1.35rem 0; }
            .subbar-tagline { font-size: .9rem; line-height: 1.5; margin: 0; color: var(--text-main); flex-shrink: 0; }
            .categories-pills-row { display: flex; gap: .5rem; min-width: 0; overflow-x: auto; scrollbar-width: none; padding: 3px 0; }
            .categories-pills-row::-webkit-scrollbar { display: none; }
            .cat-pill { border: 0; border-radius: 50px; padding: .65rem 1.1rem; background: #e7e5e1; color: var(--text-main); font: 500 .85rem var(--font-sans); white-space: nowrap; cursor: pointer; min-height: 44px; }
            .cat-pill:hover { background: #d9d6d1; }
            .cat-pill.active { background: var(--dark-authority); color: white; }
            .hero-card-section { margin-bottom: 1rem; }
            .hero-card-box { display: grid; grid-template-columns: 1fr 1fr; width: 100%; max-width: none; margin: 0; border: 1.5px solid #363638; border-radius: 12px; overflow: hidden; background: var(--bg-page); min-height: 345px; }
            .hero-media-wrap { position: relative; min-width: 0; min-height: 100%; background: #e6e1d6; }
            .hero-media-link { display: block; position: absolute; inset: 0; }
            .hero-img-element { display: block; width: 100%; height: 100%; object-fit: cover; border: 0; border-radius: 0; margin: 0; }
            .hero-content-wrap { display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 1rem; padding: 1.65rem 2rem; min-width: 0; }
            .hero-badge-pill { display: inline-flex; border-radius: 50px; padding: .45rem .85rem; background: var(--accent-terracotta); color: white; font: 700 .75rem var(--font-sans); }
            .hero-title-serif { font: 900 clamp(1.8rem, 3vw, 3rem)/1.08 var(--font-serif); letter-spacing: -.035em; margin: 0; }
            .hero-title-serif a { color: inherit; text-decoration: none; }
            .hero-description-text { font-size: .95rem; line-height: 1.5; margin: 0; color: var(--text-prose); }
            .hero-terracotta-btn { display: inline-flex; align-items: center; gap: .65rem; border-radius: 50px; padding: .8rem 1.1rem; background: var(--accent-terracotta); color: white; text-decoration: none; font: 700 .9rem var(--font-sans); }
            .hero-terracotta-btn:hover { background: var(--accent-terracotta-hover); }
            .posts-grid-4cols { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; align-items: stretch; }
            .post-grid-item-wrap { display: flex; flex-direction: column; min-width: 0; }
            #no-results { grid-column: 1 / -1; text-align: center; padding: 3rem 1rem; border: 1px dashed var(--card-border); border-radius: 12px; }
            .no-results-icon { font-size: 2rem; }
            .no-results-title { font-size: 1.4rem; }
            .reset-filter-btn { border: 0; border-radius: 50px; padding: .85rem 1.25rem; margin-top: 1rem; background: var(--accent-terracotta); color: white; cursor: pointer; font: 700 .9rem var(--font-sans); }
            .pagination-container { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--card-border); }
            .pagination-btn { padding: .75rem 1rem; border: 1px solid var(--card-border); border-radius: 50px; color: var(--text-main); text-decoration: none; font-size: .85rem; }
            .pagination-count { font-size: .8rem; }
            @media (max-width: 1199px) {
                .subbar-container { flex-direction: column; align-items: stretch; gap: .65rem; }
                .hero-content-wrap { padding: 1.5rem; }
                .posts-grid-4cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            }
            @media (max-width: 699px) {
                .home-shell { padding: 0 1rem 2.5rem; }
                .subbar-tagline { font-size: .8rem; flex-shrink: 1; }
                .cat-pill { font-size: .8rem; padding: .6rem 1rem; }
                .hero-card-box { grid-template-columns: minmax(0, 1fr); }
                .hero-media-wrap { aspect-ratio: 16 / 9; min-height: 0; }
                .hero-content-wrap { padding: 1.25rem; gap: .85rem; }
                .hero-title-serif { font-size: clamp(1.65rem, 7vw, 2.4rem); }
                .hero-description-text { font-size: .87rem; }
                .posts-grid-4cols { grid-template-columns: minmax(0, 1fr); }
                .pagination-container { gap: .5rem; flex-wrap: wrap; }
            }
        </style>
    </head>

    <body>
        <BlogHeader />

        <div class="home-shell">
            
            <!-- SUB-HEADER CON TAGLINE Y PÍLDORAS DE CATEGORÍA -->
            <section class="subbar-container" id="explorar" aria-label="Filtro de categorías">
                <p class="subbar-tagline">{settings.tagline}</p>
                
                <div class="categories-pills-row">
                    <button class="cat-pill active" aria-pressed="true" data-category="all" onclick="filterPosts('all', this)">Todo</button>
                    <button class="cat-pill" aria-pressed="false" data-category="españa" onclick="filterPosts('españa', this)">España</button>
                    <button class="cat-pill" aria-pressed="false" data-category="argentina" onclick="filterPosts('argentina', this)">Argentina</button>
                    <button class="cat-pill" aria-pressed="false" data-category="transporte" onclick="filterPosts('transporte', this)">Trenes y Vuelos</button>
                    <button class="cat-pill" aria-pressed="false" data-category="futbol" onclick="filterPosts('futbol', this)">Fútbol</button>
                    <button class="cat-pill" aria-pressed="false" data-category="hacks" onclick="filterPosts('hacks', this)">Hacks</button>
                </div>
            </section>

            <!-- HERO CARD (PÁGINA 1): ENCLOSED SINGLE CARD (1.22fr 1fr) -->
            {isFirstPage && featuredPost && (
                <section class="hero-card-section" data-search={featuredSearch} aria-label="Artículo más reciente">
                    <article class="hero-card-box">
                        <div class="hero-media-wrap">
                            <a href={featuredPost.url} class="hero-media-link" aria-label={`Leer artículo destacado: ${featuredPost.frontmatter.title}`}>
                                <img 
                                    src={featuredHeroImage} 
                                    alt="" 
                                    aria-hidden="true" 
                                    class="hero-img-element"
                                    loading="eager"
                                    fetchpriority="high"
                                    width="800"
                                    height="400"
                                />
                            </a>
                        </div>

                        <div class="hero-content-wrap">
                            <span class="hero-badge-pill">RECIENTE • {featuredTag}</span>
                            
                            <h1 class="hero-title-serif">
                                <a href={featuredPost.url}>{featuredPost.frontmatter.title}</a>
                            </h1>

                            <p class="hero-description-text">{featuredPost.frontmatter.description}</p>

                            <a href={featuredPost.url} class="hero-terracotta-btn">
                                <span>Leer la guía real</span>
                                <span aria-hidden="true">→</span>
                            </a>
                        </div>
                    </article>
                </section>
            )}

            <!-- GRID INFERIOR DE 4 COLUMNAS (PROPOSAL) -->
            <SiteAds placement="home" />
            <main class="posts-grid-4cols" id="postsGrid" aria-label="Listado de guías y crónicas">
                
                {gridPosts.map((p, index) => {
                    const tagsStr = (p.frontmatter.tags || []).join(' ').toLowerCase();
                    const searchData = `${p.frontmatter.title} ${p.frontmatter.description} ${tagsStr} ${p.url}`.toLowerCase();
                    return (<>
                        <div class="post-grid-item-wrap" data-search={searchData}>
                            <BlogPostPreview post={p} />
                        </div>
                <!-- TARJETA EDITORIAL DE AUTORIDAD ("NO SOMOS GURÚS") -->
                {isFirstPage && index === 0 && (
                    <div class="post-grid-item-wrap statement-grid-item" data-editorial="true">
                        <div class="statement-card-dark">
                            <div class="statement-icon-top" aria-hidden="true">✌️</div>
                            <blockquote class="statement-quote">
                                <span class="statement-highlight">NO SOMOS GURÚS:</span>
                                <span class="statement-body">
                                    Solo te contamos lo que realmente pasa, sin filtros, sin patrocinios. Si es una mierda, te lo diremos.
                                </span>
                            </blockquote>
                            <div class="statement-finger-bottom" aria-hidden="true">👆</div>
                        </div>
                    </div>
                )}

                    </>);

                })}

                <!-- EMPTY STATE BLINDADO -->
                <div id="no-results" style="display: none;" hidden>
                    <span class="no-results-icon">🗺️</span>
                    <h3 class="no-results-title">No encontramos artículos con ese criterio</h3>
                    <p style="margin: 0; font-size: 0.9rem;">Prueba buscando por destino, medio de transporte o ciudad.</p>
                    <button class="reset-filter-btn" onclick="resetFilters()">Ver todo el contenido</button>
                </div>
            </main>

            <!-- PAGINACIÓN -->
            <nav class="pagination-container" aria-label="Paginación de artículos">
                {page.url.prev ? <a href={page.url.prev} class="pagination-btn">← Anterior</a> : null}
                <span class="pagination-count">Página {page.currentPage} de {page.lastPage}</span>
                {page.url.next ? <a href={page.url.next} class="pagination-btn">Siguiente →</a> : null}
            </nav>

        </div>

        <Footer />

        <script is:inline>
            let currentFilter = 'all';
            const normalize = value => value.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

            window.searchPosts = function() {
                const searchInput = document.getElementById('globalSearchInput');
                const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
                const cards = document.querySelectorAll('[data-search]');
                const noResults = document.getElementById('no-results');
                let visibleCount = 0;

                cards.forEach(card => {
                    const data = normalize(card.getAttribute('data-search') || '');
                    const matchesQuery = query === '' || normalize(data).includes(normalize(query));
                    const matchesCategory = currentFilter === 'all' || 
                        (currentFilter === 'españa' && (data.includes('espana') || data.includes('barcelona') || data.includes('madrid') || data.includes('segovia'))) ||
                        (currentFilter === 'argentina' && (data.includes('argentina') || data.includes('patagonia') || data.includes('chalten') || data.includes('pampa') || data.includes('ushuaia') || data.includes('buenos aires'))) ||
                        (currentFilter === 'transporte' && (data.includes('tren') || data.includes('vuelo') || data.includes('metro') || data.includes('transporte') || data.includes('autobus') || data.includes('avion'))) ||
                        (currentFilter === 'futbol' && (data.includes('futbol') || data.includes('bernabeu') || data.includes('estadio') || data.includes('real madrid'))) ||
                        (currentFilter === 'hacks' && (data.includes('hack') || data.includes('mochila') || data.includes('maleta') || data.includes('vpn') || data.includes('gratis') || data.includes('consejos')));

                    if (matchesQuery && matchesCategory) {
                        card.hidden = false;
                        visibleCount++;
                    } else {
                        card.hidden = true;
                    }
                });

                const editorial = document.querySelector('[data-editorial]');
                if (editorial) editorial.hidden = query !== '' || currentFilter !== 'all';

                if (noResults) {
                    if (visibleCount === 0) {
                        noResults.style.display = 'block';
                        noResults.removeAttribute('hidden');
                    } else {
                        noResults.style.display = 'none';
                        noResults.setAttribute('hidden', '');
                    }
                }
            };

            window.filterPosts = function(category, btnElement) {
                currentFilter = category;
                document.querySelectorAll('.cat-pill').forEach(btn => btn.classList.remove('active'));
                if (btnElement) btnElement.classList.add('active');
                document.querySelectorAll('.cat-pill').forEach(btn => btn.setAttribute('aria-pressed', String(btn === btnElement)));
                window.searchPosts();
            };

            window.resetFilters = function() {
                const searchInput = document.getElementById('globalSearchInput');
                if (searchInput) searchInput.value = '';
                const allBtn = document.querySelector('.cat-pill[data-category="all"]');
                window.filterPosts('all', allBtn);
            };
        </script>
    </body>
</html>