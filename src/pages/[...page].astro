---
// Component Imports
import BaseHead from '../components/BaseHead.astro';
import BlogHeader from '../components/BlogHeader.astro';
import BlogPostPreview from '../components/BlogPostPreview.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';

// --- MAGIA DE PAGINACIÓN (Astro) ---
export async function getStaticPaths({ paginate }) {
  let allPosts = await Astro.glob('./posts/*.md');
  allPosts = allPosts.sort(
    (a, b) => new Date(b.frontmatter.publishDate).valueOf() - new Date(a.frontmatter.publishDate).valueOf()
  );
  
  // Post destacado: Prioriza el post con featured: true o el de tren a barcelona
  const featuredPost = allPosts.find((p) => p.frontmatter.featured === true || p.url.includes('tren-o-avi-n-a-barcelona')) || allPosts[0];

  return paginate(allPosts, { 
    pageSize: 13,
    props: { featuredPost }
  });
}

const { page, featuredPost } = Astro.props;

// En página 1 mostramos el Hero Post y el resto en el grid
const isFirstPage = page.currentPage === 1;
const gridPosts = isFirstPage 
  ? page.data.filter((p) => p.url !== featuredPost.url)
  : page.data;

const title = 'Instante Trips & Tips | Guías Reales de Viaje sin Filtros';
const description = 'Guías de viaje reales, sin filtros y directo al grano: trenes, vuelos, presupuestos honestos y decisiones inteligentes.';
const permalink = Astro.url.href;

const featuredHeroImage = featuredPost.frontmatter.heroImage || featuredPost.frontmatter.heroImageLink || 'https://res.cloudinary.com/dbwdmu9k2/image/upload/v1769926152/DSCF3740_ava5eg.jpg';
const featuredTag = 'ESPAÑA';
---

<html lang="es">
    <head>
        <BaseHead {title} {description} {permalink} image={featuredHeroImage} />

        <style>
            .home-shell {
                max-width: 1220px;
                margin: 0 auto;
                padding: 1.25rem 1.5rem 4rem;
                box-sizing: border-box;
            }

            /* --- BARRA SUB-HEADER CON TAGLINE Y PÍLDORAS --- */
            .subbar-container {
                display: flex;
                flex-direction: column;
                gap: 1rem;
                margin: 1rem 0 1.5rem;
            }

            @media (min-width: 860px) {
                .subbar-container {
                    flex-direction: row;
                    align-items: center;
                    justify-content: space-between;
                }
            }

            .subbar-tagline {
                font-family: var(--font-sans);
                font-size: 0.95rem;
                color: #52525B;
                font-weight: 500;
                margin: 0;
            }

            .categories-pills-row {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
                scrollbar-width: none;
                padding-bottom: 2px;
            }

            .categories-pills-row::-webkit-scrollbar {
                display: none;
            }

            .cat-pill {
                font-family: var(--font-sans);
                font-size: 0.8rem;
                font-weight: 700;
                padding: 0.42rem 1rem;
                border-radius: 50px;
                border: 1px solid #E6E1D6;
                background: #F0ECE4;
                color: #18181B;
                cursor: pointer;
                transition: all 0.15s ease;
                white-space: nowrap;
            }

            .cat-pill:hover {
                background: #E5DFD5;
            }

            .cat-pill.active {
                background: #18181B;
                color: #FFFFFF;
                border-color: #18181B;
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
            }

            /* --- HERO CARD UNIFICADA (1.22fr 1fr) --- */
            .hero-card-section {
                margin-bottom: 1.75rem;
            }

            .hero-card-box {
                background: var(--card-bg, #FFFFFF);
                border: 1px solid var(--card-border, #E6E1D6);
                border-radius: 20px;
                box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
                overflow: hidden;
                display: grid;
                grid-template-columns: 1fr;
            }

            @media (min-width: 960px) {
                .hero-card-box {
                    grid-template-columns: 1.22fr 1fr;
                    height: 395px;
                }
            }

            .hero-media-wrap {
                width: 100%;
                height: 100%;
                overflow: hidden;
                position: relative;
                background: #EAE6DF;
            }

            @media (max-width: 959px) {
                .hero-media-wrap {
                    height: 250px;
                }
            }

            .hero-media-link {
                display: block;
                width: 100%;
                height: 100%;
            }

            .hero-img-element {
                width: 100%;
                height: 100%;
                object-fit: cover;
                object-position: center;
                display: block;
                transition: transform 0.4s ease;
            }

            .hero-card-box:hover .hero-img-element {
                transform: scale(1.025);
            }

            .hero-content-wrap {
                padding: 2.25rem 2.5rem;
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: flex-start;
                gap: 0.85rem;
                box-sizing: border-box;
            }

            @media (max-width: 600px) {
                .hero-content-wrap {
                    padding: 1.5rem;
                }
            }

            .hero-badge-pill {
                display: inline-flex;
                align-items: center;
                background: var(--accent-terracotta, #D95D24);
                color: #FFFFFF;
                font-family: var(--font-sans);
                font-size: 0.72rem;
                font-weight: 800;
                letter-spacing: 0.6px;
                padding: 0.3rem 0.85rem;
                border-radius: 50px;
                text-transform: uppercase;
            }

            .hero-title-serif {
                font-family: var(--font-serif);
                font-size: clamp(1.65rem, 2.3vw, 2.35rem);
                font-weight: 900;
                line-height: 1.15;
                color: var(--text-main, #18181B);
                margin: 0;
            }

            .hero-title-serif a {
                color: inherit;
                text-decoration: none;
                transition: color 0.15s ease;
            }

            .hero-title-serif a:hover {
                color: var(--accent-terracotta, #D95D24);
            }

            .hero-description-text {
                font-family: var(--font-sans);
                font-size: 0.95rem;
                line-height: 1.5;
                color: var(--text-muted, #52525B);
                margin: 0;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }

            .hero-terracotta-btn {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                background: var(--accent-terracotta, #D95D24);
                color: #FFFFFF !important;
                text-decoration: none !important;
                font-family: var(--font-sans);
                font-weight: 700;
                font-size: 0.92rem;
                padding: 0.75rem 1.6rem;
                border-radius: 50px;
                transition: all 0.2s ease;
                box-shadow: 0 4px 14px rgba(217, 93, 36, 0.25);
            }

            .hero-terracotta-btn:hover {
                background: var(--accent-terracotta-hover, #B84A18);
                transform: translateY(-2px);
                box-shadow: 0 6px 18px rgba(217, 93, 36, 0.35);
            }

            /* --- GRID INFERIOR DE 4 COLUMNAS (PROPOSAL) --- */
            .posts-grid-4cols {
                display: grid;
                grid-template-columns: 1fr;
                gap: 1.25rem;
            }

            @media (min-width: 600px) {
                .posts-grid-4cols {
                    grid-template-columns: repeat(2, 1fr);
                }
            }

            @media (min-width: 1040px) {
                .posts-grid-4cols {
                    grid-template-columns: repeat(4, 1fr);
                    gap: 1.25rem;
                }
            }

            .post-grid-item-wrap {
                display: flex;
                flex-direction: column;
                height: 100%;
            }

            /* EMPTY STATE BLINDADO */
            #no-results {
                grid-column: 1 / -1;
                text-align: center;
                padding: 4rem 1.5rem;
                background: #FFFFFF;
                border: 1px dashed var(--card-border);
                border-radius: 16px;
                color: var(--text-muted);
            }

            .no-results-icon {
                font-size: 2.5rem;
                display: block;
                margin-bottom: 0.8rem;
            }

            .no-results-title {
                font-family: var(--font-serif);
                font-size: 1.3rem;
                font-weight: 800;
                color: var(--text-main);
                margin: 0 0 0.5rem;
            }

            .reset-filter-btn {
                background: var(--accent-terracotta);
                color: #FFFFFF;
                border: none;
                padding: 0.65rem 1.4rem;
                border-radius: 50px;
                font-weight: 700;
                font-family: var(--font-sans);
                cursor: pointer;
                margin-top: 1rem;
            }

            /* PAGINACIÓN */
            .pagination-container {
                display: flex;
                justify-content: center;
                align-items: center;
                gap: 1.5rem;
                margin-top: 3.5rem;
                padding-top: 2rem;
                border-top: 1px solid var(--card-border);
            }

            .pagination-btn {
                text-decoration: none;
                padding: 0.7rem 1.5rem;
                border-radius: 50px;
                background: #FFFFFF;
                border: 1px solid var(--card-border);
                color: var(--text-main);
                font-family: var(--font-sans);
                font-weight: 700;
                font-size: 0.88rem;
                transition: all 0.2s ease;
            }

            .pagination-btn:hover {
                background: var(--text-main);
                color: #FFFFFF;
            }

            .pagination-count {
                font-family: var(--font-sans);
                font-size: 0.9rem;
                font-weight: 700;
                color: var(--text-muted);
            }
        </style>
    </head>

    <body>
        <BlogHeader />

        <div class="home-shell">
            
            <!-- SUB-HEADER CON TAGLINE Y PÍLDORAS DE CATEGORÍA -->
            <section class="subbar-container" id="explorar" aria-label="Filtro de categorías">
                <p class="subbar-tagline">Guías de viaje reales, sin filtros y directo al grano</p>
                
                <div class="categories-pills-row">
                    <button class="cat-pill active" data-category="all" onclick="filterPosts('all', this)">Todo</button>
                    <button class="cat-pill" data-category="españa" onclick="filterPosts('españa', this)">España</button>
                    <button class="cat-pill" data-category="argentina" onclick="filterPosts('argentina', this)">Argentina</button>
                    <button class="cat-pill" data-category="transporte" onclick="filterPosts('transporte', this)">Trenes y Vuelos</button>
                    <button class="cat-pill" data-category="futbol" onclick="filterPosts('futbol', this)">Fútbol</button>
                    <button class="cat-pill" data-category="hacks" onclick="filterPosts('hacks', this)">Hacks</button>
                </div>
            </section>

            <!-- HERO CARD (PÁGINA 1): ENCLOSED SINGLE CARD (1.22fr 1fr) -->
            {isFirstPage && featuredPost && (
                <section class="hero-card-section" aria-label="Artículo destacado">
                    <article class="hero-card-box">
                        <div class="hero-media-wrap">
                            <a href={featuredPost.url} class="hero-media-link" aria-label={`Leer artículo destacado: ${featuredPost.frontmatter.title}`}>
                                <img 
                                    src={featuredHeroImage} 
                                    alt="" 
                                    aria-hidden="true" 
                                    class="hero-img-element"
                                    loading="eager"
                                    fetchpriority="high"
                                    width="800"
                                    height="400"
                                />
                            </a>
                        </div>

                        <div class="hero-content-wrap">
                            <span class="hero-badge-pill">RECIENTE • {featuredTag}</span>
                            
                            <h2 class="hero-title-serif">
                                <a href={featuredPost.url}>{featuredPost.frontmatter.title}</a>
                            </h2>

                            <p class="hero-description-text">{featuredPost.frontmatter.description}</p>

                            <a href={featuredPost.url} class="hero-terracotta-btn">
                                <span>Leer la guía real</span>
                                <span aria-hidden="true">→</span>
                            </a>
                        </div>
                    </article>
                </section>
            )}

            <!-- GRID INFERIOR DE 4 COLUMNAS (PROPOSAL) -->
            <main class="posts-grid-4cols" id="postsGrid" aria-label="Listado de guías y crónicas">
                
                <!-- TARJETA EDITORIAL DE AUTORIDAD ("NO SOMOS GURÚS") -->
                {isFirstPage && (
                    <div class="post-grid-item-wrap" data-search="no somos gurus sobre nosotros honestidad tips">
                        <div class="statement-card-dark">
                            <div class="statement-icon-top" aria-hidden="true">✌️</div>
                            <blockquote class="statement-quote">
                                <span class="statement-highlight">"NO SOMOS GURÚS:</span>
                                <span class="statement-body">
                                    Solo te contamos lo que realmente pasa, sin filtros, sin patrocinios. Si es una mierda, te lo diremos.
                                </span>
                            </blockquote>
                            <div class="statement-finger-bottom" aria-hidden="true">👆</div>
                        </div>
                    </div>
                )}

                {gridPosts.map((p) => {
                    const tagsStr = (p.frontmatter.tags || []).join(' ').toLowerCase();
                    const searchData = `${p.frontmatter.title} ${p.frontmatter.description} ${tagsStr} ${p.url}`.toLowerCase();
                    return (
                        <div class="post-grid-item-wrap" data-search={searchData}>
                            <BlogPostPreview post={p} />
                        </div>
                    );
                })}

                <!-- EMPTY STATE BLINDADO -->
                <div id="no-results" style="display: none;" hidden>
                    <span class="no-results-icon">🗺️</span>
                    <h3 class="no-results-title">No encontramos artículos con ese criterio</h3>
                    <p style="margin: 0; font-size: 0.9rem;">Prueba buscando por destino, medio de transporte o ciudad.</p>
                    <button class="reset-filter-btn" onclick="resetFilters()">Ver todo el contenido</button>
                </div>
            </main>

            <!-- PAGINACIÓN -->
            <nav class="pagination-container" aria-label="Paginación de artículos">
                {page.url.prev ? <a href={page.url.prev} class="pagination-btn">← Anterior</a> : null}
                <span class="pagination-count">Página {page.currentPage} de {page.lastPage}</span>
                {page.url.next ? <a href={page.url.next} class="pagination-btn">Siguiente →</a> : null}
            </nav>

        </div>

        <Footer />

        <script is:inline>
            let currentFilter = 'all';

            window.searchPosts = function() {
                const searchInput = document.getElementById('globalSearchInput');
                const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
                const cards = document.querySelectorAll('.post-grid-item-wrap');
                const noResults = document.getElementById('no-results');
                let visibleCount = 0;

                cards.forEach(card => {
                    const data = card.getAttribute('data-search') || '';
                    const matchesQuery = query === '' || data.includes(query);
                    const matchesCategory = currentFilter === 'all' || 
                        (currentFilter === 'españa' && (data.includes('españa') || data.includes('barcelona') || data.includes('madrid') || data.includes('segovia'))) ||
                        (currentFilter === 'argentina' && (data.includes('argentina') || data.includes('patagonia') || data.includes('chalten') || data.includes('pampa') || data.includes('ushuaia') || data.includes('buenos aires'))) ||
                        (currentFilter === 'transporte' && (data.includes('tren') || data.includes('vuelo') || data.includes('metro') || data.includes('transporte') || data.includes('autobus') || data.includes('avion'))) ||
                        (currentFilter === 'futbol' && (data.includes('futbol') || data.includes('bernabeu') || data.includes('estadio') || data.includes('real madrid'))) ||
                        (currentFilter === 'hacks' && (data.includes('hack') || data.includes('mochila') || data.includes('maleta') || data.includes('vpn') || data.includes('gratis') || data.includes('consejos')));

                    if (matchesQuery && matchesCategory) {
                        card.style.display = 'flex';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                if (noResults) {
                    if (visibleCount === 0) {
                        noResults.style.display = 'block';
                        noResults.removeAttribute('hidden');
                    } else {
                        noResults.style.display = 'none';
                        noResults.setAttribute('hidden', '');
                    }
                }
            };

            window.filterPosts = function(category, btnElement) {
                currentFilter = category;
                document.querySelectorAll('.cat-pill').forEach(btn => btn.classList.remove('active'));
                if (btnElement) btnElement.classList.add('active');
                window.searchPosts();
            };

            window.resetFilters = function() {
                const searchInput = document.getElementById('globalSearchInput');
                if (searchInput) searchInput.value = '';
                const allBtn = document.querySelector('.cat-pill[data-category="all"]');
                window.filterPosts('all', allBtn);
            };
        </script>
    </body>
</html>