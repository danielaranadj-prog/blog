---
import BaseHead from '../../components/BaseHead.astro';
import BlogHeader from '../../components/BlogHeader.astro';
import Footer from '../../components/Footer.astro';
import SiteAds from '../../components/SiteAds.astro';
import settings from '../../data/site-settings.json';
import {buildCountryHubs} from '../../utils/country-hubs.mjs';
import {optimizeImageUrl} from '../../config/affiliates';
const allPosts=await Astro.glob('../posts/*.md'),hubs=buildCountryHubs(allPosts);
---
<html lang="es"><head><BaseHead title={`Destinos | ${settings.name}`} description="Encuentra las historias y guías de Instante Trips organizadas por destino." permalink={new URL('/destinos/',Astro.site).href}/></head><body><BlogHeader/>
<main class="travel-shell"><a class="travel-back" href="/">← Volver a las historias</a><header class="travel-heading"><span class="travel-kicker">Instante / Elige tu próxima parada</span><h1>Un lugar.<br/>Muchas historias.</h1><p class="travel-intro">Empieza por el destino. Aquí reunimos nuestras rutas, experiencias y consejos para que encuentres lo que te sirve para tu viaje.</p><div class="destination-counts"><span>{hubs.length} destinos</span><span>{allPosts.length} historias publicadas</span></div></header><SiteAds placement="home"/>
<section class="destination-grid" aria-label="Destinos disponibles">{hubs.map(hub=><article class="destination-card"><a class="destination-photo" href={`/destinos/${hub.slug}/`} tabindex="-1" aria-hidden="true"><img src={optimizeImageUrl(hub.heroImage,800)} alt="" width="800" height="500" loading="lazy"/></a><div class="destination-copy"><span class="travel-kicker">{hub.region} · {hub.count} {hub.count===1?'historia':'historias'}</span><h2><a href={`/destinos/${hub.slug}/`}>{hub.name}<span aria-hidden="true">↗</span></a></h2><p>{hub.tagline}</p><ul>{hub.posts.slice(0,2).map(post=><li><a href={post.url}>{post.frontmatter.title}</a></li>)}</ul></div></article>)}</section>
</main><Footer/></body></html>
<style>.destination-counts{display:flex;gap:1.5rem;margin-top:1.5rem;font-size:.7rem;color:var(--text-secondary);font-weight:700}.destination-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.25rem}.destination-card{border:var(--border-ink);border-radius:var(--radius-card);background:var(--surface-paper);overflow:hidden;min-width:0;display:flex;flex-direction:column}.destination-photo{display:block;overflow:hidden;border-bottom:1px solid var(--card-border)}.destination-photo img{width:100%;height:auto;aspect-ratio:8/5;object-fit:cover;display:block;transition:transform .25s}.destination-card:hover img{transform:scale(1.025)}.destination-copy{padding:1.5rem;flex:1}.destination-copy h2{font:800 2rem/1.2 var(--font-serif);margin:.6rem 0 1rem}.destination-copy h2 a{display:flex;justify-content:space-between;color:var(--text-main);text-decoration:none}.destination-copy h2 span{font:500 1.3rem var(--font-sans);color:var(--accent-ink)}.destination-copy p{font-size:.8rem;line-height:1.8;color:var(--text-secondary);margin:0 0 1.25rem}.destination-copy ul{list-style:none;padding:0;margin:0;border-top:1px solid var(--card-border)}.destination-copy li{border-bottom:1px solid var(--card-border)}.destination-copy li a{display:block;padding:.8rem 0;font-size:.72rem;line-height:1.6;color:var(--text-main);text-decoration:none}.destination-copy a:hover{color:var(--accent-ink)}@media(max-width:900px){.destination-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.destination-grid{grid-template-columns:minmax(0,1fr)}}
</style>
