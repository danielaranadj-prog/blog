---
import BaseHead from '../../components/BaseHead.astro';
import BlogHeader from '../../components/BlogHeader.astro';
import Footer from '../../components/Footer.astro';
import BlogPostPreview from '../../components/BlogPostPreview.astro';
import SiteAds from '../../components/SiteAds.astro';
import Recommendations from '../../components/Recommendations.astro';
import LeadMagnetInContent from '../../components/LeadMagnetInContent.astro';
import settings from '../../data/site-settings.json';
import {getNewsletterUrl} from '../../utils/newsletter.mjs';
import { buildCountryHubs } from '../../utils/country-hubs.mjs';
import { optimizeImageUrl } from '../../config/affiliates';
import { jsonLd } from '../../utils/article-seo.mjs';

export async function getStaticPaths() {
  const allPosts = await Astro.glob('../posts/*.md');
  const hubs = buildCountryHubs(allPosts);

  return hubs.map((hub) => ({
    params: { pais: hub.slug },
    props: {
      hub,
      otherHubs: hubs.filter((h) => h.slug !== hub.slug),
    },
  }));
}

const { hub, otherHubs = [] } = Astro.props;
const permalink = new URL(`/destinos/${hub.slug}/`, Astro.site || 'https://www.instantetrips.com').href;
const heroImg = optimizeImageUrl(hub.heroImage, 1200);
const showLeadMagnet = Boolean(getNewsletterUrl(settings.audience?.newsletterUrl));

const hubSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Guías de Viaje a ${hub.name} | ${settings.name}`,
  description: hub.description,
  url: permalink,
  isPartOf: {
    '@type': 'WebSite',
    name: settings.name,
    url: 'https://www.instantetrips.com/',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://www.instantetrips.com/' },
      { '@type': 'ListItem', position: 2, name: 'Destinos', item: 'https://www.instantetrips.com/destinos/' },
      { '@type': 'ListItem', position: 3, name: hub.name, item: permalink },
    ],
  },
};
---
<html lang="es"><head><BaseHead title={`${hub.name}: historias y guías de viaje | ${settings.name}`} description={hub.description} permalink={permalink} image={heroImg}/><script type="application/ld+json" set:html={jsonLd(hubSchema)}/></head><body><BlogHeader/>
<main class="travel-shell"><nav class="hub-breadcrumbs" aria-label="Migas de pan"><a href="/">Inicio</a><span aria-hidden="true">/</span><a href="/destinos/">Destinos</a><span aria-hidden="true">/</span><span aria-current="page">{hub.name}</span></nav>
<header class="country-hero"><div class="country-hero-copy"><span class="travel-kicker">Instante / {hub.region} · {hub.count} {hub.count===1?'historia':'historias'}</span><h1>{hub.name},<br/>sin filtros.</h1><p class="travel-intro">{hub.description}</p><a class="travel-button travel-button-primary" href="#guias">Explorar las historias ↓</a></div><div class="country-hero-media"><img src={heroImg} alt={`Una vista de ${hub.name}`} width="720" height="500" fetchpriority="high" loading="eager"/></div></header>
{hub.facts?.length>0&&<dl class="country-facts">{hub.facts.map(fact=><div><dt class="travel-kicker">{fact.label}</dt><dd>{fact.value}</dd></div>)}</dl>}
<SiteAds placement="home"/>
<div class="country-layout"><section id="guias" class="country-stories"><span class="travel-kicker">En el camino</span><h2 class="travel-section-title">Las historias de {hub.name}</h2><div class="country-posts">{hub.posts.map(post=><BlogPostPreview post={post}/>)}</div><SiteAds placement="article"/>{showLeadMagnet&&<LeadMagnetInContent/>}</section>
<aside class="country-sidebar" aria-label={`Recursos para ${hub.name}`}><Recommendations tags={hub.recommendationTags}/><SiteAds placement="sidebar"/>
{settings.sponsor?.enabled&&settings.sponsor?.confirmed&&<div class="travel-resource"><span class="travel-kicker">Enlace patrocinado</span><h3>{settings.sponsor.title}</h3><p>{settings.sponsor.text}</p><a href={settings.sponsor.url} target="_blank" rel="sponsored nofollow noopener" data-track="affiliate_click">{settings.sponsor.button} ↗</a></div>}
{otherHubs.length>0&&<nav class="other-destinations" aria-label="Otros destinos"><span class="travel-kicker">La próxima parada</span>{otherHubs.map(other=><a href={`/destinos/${other.slug}/`}>{other.name}<span>{other.count} {other.count===1?'historia':'historias'} →</span></a>)}</nav>}
</aside></div></main><Footer/></body></html>
<style>.hub-breadcrumbs{display:flex;flex-wrap:wrap;gap:.65rem;font-size:.7rem;color:var(--text-secondary);margin-bottom:1.5rem}.hub-breadcrumbs a{color:inherit;text-decoration:none}.country-hero{display:grid;grid-template-columns:1.1fr 1fr;border:var(--border-ink);border-radius:var(--radius-card);overflow:hidden;background:var(--surface-paper)}.country-hero-copy{padding:clamp(1.5rem,3vw,2.75rem);align-self:center}.country-hero h1{font:900 clamp(2.8rem,5vw,4.5rem)/1.03 var(--font-serif);letter-spacing:-.045em;margin:.75rem 0 1.25rem}.country-hero .travel-intro{font-size:.86rem;line-height:1.85}.country-hero .travel-button{margin-top:1.5rem}.country-hero-media{position:relative;min-height:360px}.country-hero-media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.country-facts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1.5rem;border-bottom:1px solid var(--card-border);padding:1.75rem 0;margin:0}.country-facts dt{font-size:.6rem}.country-facts dd{margin:.5rem 0 0;font-size:.75rem;line-height:1.8;color:var(--text-secondary)}.country-layout{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:2rem;margin-top:3rem;align-items:start}.country-stories{min-width:0;scroll-margin-top:160px}.country-posts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem;margin-top:1.5rem}.country-sidebar{display:grid;gap:1.5rem;min-width:0}.other-destinations{border-top:var(--border-ink);padding-top:1rem}.other-destinations>a{display:flex;justify-content:space-between;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--card-border);color:var(--text-main);text-decoration:none;font:700 1rem var(--font-serif)}.other-destinations>a span{font:500 .65rem var(--font-sans);color:var(--text-secondary)}@media(max-width:1000px){.country-layout{grid-template-columns:minmax(0,1fr)}.country-sidebar{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:650px){.country-hero{grid-template-columns:minmax(0,1fr)}.country-hero-media{height:230px;min-height:0;order:-1}.country-facts{grid-template-columns:repeat(2,minmax(0,1fr));gap:1.2rem}.country-posts,.country-sidebar{grid-template-columns:minmax(0,1fr)}}
</style>
