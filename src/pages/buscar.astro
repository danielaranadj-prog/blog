---
import EditorialPage from '../layouts/EditorialPage.astro';
---
<EditorialPage noindex={true} title="Encuentra tu próxima historia" description="Busca entre todas las guías de Instante Trips." eyebrow="Buscar"><form id="full-search" role="search"><label for="search-query">Destino, tema o palabra</label><input id="search-query" name="q" type="search"/><button>Buscar</button></form><p id="search-status" role="status" aria-live="polite"></p><div id="search-matches"></div></EditorialPage>
<script>
 const form=document.querySelector<HTMLFormElement>('#full-search'),input=document.querySelector<HTMLInputElement>('#search-query'),box=document.querySelector('#search-matches'),status=document.querySelector('#search-status');let cached,seq=0;
 async function run(){const n=++seq;const q=input.value.trim();box.replaceChildren();if(!q){status.textContent='Escribe qué te gustaría encontrar.';return;}status.textContent='Buscando en todas las historias…';try{cached??=await fetch('/search-index.json').then(r=>{if(!r.ok)throw Error();return r.json();});if(n!==seq)return;const normal=s=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();const words=normal(q).split(/\s+/);const list=cached.filter(p=>words.every(w=>normal([p.title,p.description,...p.tags,p.text].join(' ')).includes(w)));status.textContent=`${list.length} historias encontradas`;for(const p of list){const article=document.createElement('article'),h=document.createElement('h2'),a=document.createElement('a'),desc=document.createElement('p');a.href=p.url;a.textContent=p.title;h.append(a);desc.textContent=p.description;article.append(h,desc);box.append(article);}}catch{status.textContent='No se pudo cargar la búsqueda. Inténtalo otra vez.';}}
 input.value=new URLSearchParams(location.search).get('q')||'';form.addEventListener('submit',e=>{e.preventDefault();history.replaceState(null,'','/buscar?q='+encodeURIComponent(input.value));run();});run();
</script>
<style>#full-search{display:flex;gap:.8rem;flex-wrap:wrap}label{flex-basis:100%}input{flex:1;min-width:0;padding:.8rem;border:1px solid #18181B;border-radius:8px;font:inherit}button{background:#E04F16;color:white;padding:.8rem 1rem;border:1px solid #18181B;border-radius:999px;font:inherit}#search-matches article{border-bottom:1px solid #D6D1C4;padding:1rem 0}</style>
