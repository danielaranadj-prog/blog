---
import BaseHead from '../components/BaseHead.astro';
import BlogHeader from '../components/BlogHeader.astro';
import Footer from '../components/Footer.astro';
import TravelIcon from '../components/TravelIcon.astro';
import settings from '../data/site-settings.json';
const enabled=settings.tools?.savedRoutes!==false;
---
<html lang="es"><head><BaseHead title={`Mi Ruta | ${settings.name}`} description="Reúne tus guías favoritas de Instante Trips y vuelve a ellas cuando prepares tu viaje." permalink={new URL('/mi-ruta/',Astro.site).href} noindex={true}/></head><body><BlogHeader/>
<main class="travel-shell"><a class="travel-back" href="/">← Volver a las historias</a><header class="travel-heading"><span class="travel-kicker">Instante / Tu próxima escapada</span><h1>Tu viaje empieza<br/>con una idea.</h1><p class="travel-intro">Reúne aquí las guías que quieres volver a leer. Tu lista se guarda en este navegador y dispositivo.</p></header>
{enabled?<section id="savedRouteContainer" aria-label="Mis guías guardadas"><div id="emptyRouteState" class="travel-empty"><TravelIcon name="map"/><h2>Tu ruta está por escribir.</h2><p>Abre una historia y pulsa “Guardar en Mi Ruta”. La tendrás a mano para seguir preparando tu viaje.</p><a class="travel-button travel-button-primary" href="/#explorar">Encontrar mi próxima guía →</a></div><div id="savedRouteGrid" class="travel-card-grid" hidden></div><p id="route-status" role="status" class="travel-note"></p><noscript><p>Activa JavaScript para consultar las guías guardadas en tu navegador.</p></noscript></section>:<p class="travel-intro">La lista de guías está desactivada por el momento.</p>}
</main><Footer/>
<script>
import {readSavedRoutes,writeSavedRoutes} from '../utils/saved-routes.mjs';
const grid=document.querySelector('#savedRouteGrid'),empty=document.querySelector<HTMLElement>('#emptyRouteState'),status=document.querySelector('#route-status');
const getItems=()=>{try{return readSavedRoutes(localStorage);}catch{return [];}};
function render(){
  if(!grid||!empty)return;const items=getItems();grid.replaceChildren();empty.hidden=items.length>0;(grid as HTMLElement).hidden=items.length===0;
  for(const item of items){
    const card=document.createElement('article');card.className='travel-resource';
    const label=document.createElement('span');label.className='travel-kicker';label.textContent=item.category;
    const heading=document.createElement('h2'),title=document.createElement('a');title.href=item.url;title.textContent=item.title;heading.append(title);
    const actions=document.createElement('div');actions.className='saved-card-actions';
    const link=document.createElement('a');link.href=item.url;link.className='travel-button travel-button-primary';link.textContent='Abrir guía →';
    const remove=document.createElement('button');remove.type='button';remove.className='travel-button';remove.textContent='Quitar';remove.setAttribute('aria-label',`Quitar ${item.title} de Mi Ruta`);
    remove.addEventListener('click',()=>{
      let ok=false;try{ok=writeSavedRoutes(localStorage,getItems().filter(saved=>saved.url!==item.url));}catch{}
      if(status)status.textContent=ok?'Guía quitada de tu lista.':'No se pudo actualizar la lista. Comprueba el almacenamiento del navegador.';
      if(ok){window.dispatchEvent(new Event('instante-route-change'));render();(grid.querySelector('button')||empty.querySelector('a'))?.focus();}
    });
    actions.append(link,remove);card.append(label,heading,actions);grid.append(card);
  }
}
render();window.addEventListener('storage',render);
</script>
<style is:global>
#savedRouteGrid{grid-template-columns:repeat(2,minmax(0,1fr))}#savedRouteGrid h2{font:800 1.6rem/1.25 var(--font-serif);margin:.8rem 0 1.5rem}#savedRouteGrid h2 a{color:var(--text-main);text-decoration:none}.saved-card-actions{margin-top:auto;display:flex;flex-wrap:wrap;gap:.5rem;justify-content:space-between}.saved-card-actions .travel-button{font-size:.7rem}@media(max-width:650px){#savedRouteGrid{grid-template-columns:minmax(0,1fr)}}
</style>
</body></html>
