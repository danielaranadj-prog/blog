---
import BaseHead from '../components/BaseHead.astro';
import BlogHeader from '../components/BlogHeader.astro';
import Footer from '../components/Footer.astro';
import SiteAds from '../components/SiteAds.astro';
import settings from '../data/site-settings.json';
const active=(settings.catalog||[]).filter(i=>i.enabled&&i.confirmed&&i.placement!=='manual');
const downloads=active.filter(i=>i.type==='download');
const affiliates=active.filter(i=>i.type==='affiliate');
const sponsor=settings.sponsor?.enabled&&settings.sponsor?.confirmed?settings.sponsor:null;
const categories={transport:'Transporte',activity:'Actividades',stay:'Alojamiento',insurance:'Seguro',resource:'Conectividad y recursos'};
---
<html lang="es"><head><BaseHead title={`Recursos para preparar tu viaje | ${settings.name}`} description="Enlaces a plataformas de viaje y recursos descargables publicados en el catálogo de Instante Trips." permalink={new URL('/recursos/',Astro.site).href}/></head><body><BlogHeader/>
<main class="travel-shell"><a class="travel-back" href="/">← Volver a las historias</a>
<header class="travel-heading"><span class="travel-kicker">Instante / Antes de salir</span><h1>Recursos para<br/>tu próximo viaje.</h1><p class="travel-intro">{downloads.length>0?"Enlaces a plataformas de viaje y materiales descargables publicados en nuestro catálogo.":"Enlaces a plataformas de transporte, actividades y conectividad. Los enlaces de afiliación están identificados como tales."}</p>{downloads.length>0&&<nav class="travel-nav" aria-label="Recursos disponibles">{(affiliates.length>0||sponsor)&&<a href="#herramientas-probadas">Plataformas de viaje ↗</a>}{downloads.length>0&&<a href="#descargas">Descargas ↓</a>}</nav>}</header>
<SiteAds placement="home"/>
{(affiliates.length>0||sponsor)&&<section class="travel-directory" id="herramientas-probadas"><span class="travel-kicker">Para preparar el camino</span><h2 class="travel-section-title">Plataformas de viaje</h2><p class="travel-note">Estos son enlaces de afiliación. Podemos recibir una comisión si reservas. Comprueba disponibilidad, precio final y condiciones en el proveedor.</p><div class="travel-card-grid">{affiliates.map(item=><article class="travel-resource"><span class="travel-kicker">{categories[item.category]||'Recurso'} · {item.provider}</span><h3>{item.title}</h3>{item.text&&<p>{item.text}</p>}<a href={item.url} target="_blank" rel="sponsored nofollow noopener" data-track="affiliate_click" data-catalog-id={item.id}>{item.button||'Consultar en el proveedor'} ↗</a></article>)}{sponsor&&<article class="travel-resource"><span class="travel-kicker">Enlace patrocinado</span><h3>{sponsor.title}</h3><p>{sponsor.text}</p><a href={sponsor.url} target="_blank" rel="sponsored nofollow noopener" data-track="affiliate_click">{sponsor.button} ↗</a></article>}</div></section>}
{downloads.length>0&&<section class="travel-directory" id="descargas"><span class="travel-kicker">Para llevar contigo</span><h2 class="travel-section-title">Recursos descargables</h2><div class="travel-card-grid">{downloads.map(item=><article class="travel-resource">{item.image&&<img src={item.image} alt="" loading="lazy" width="640" height="360"/>}<span class="travel-kicker">Recurso · {item.tags||'Viajes'}</span><h3>{item.title}</h3>{item.text&&<p>{item.text}</p>}<a href={item.url} target="_blank" rel="noopener" data-track="download_click" data-catalog-id={item.id}>{item.button||'Abrir recurso'} ↗</a></article>)}</div></section>}
{affiliates.length===0&&!sponsor&&downloads.length===0&&<section class="travel-empty"><h2>Estamos preparando esta biblioteca.</h2><p>Los recursos aparecerán aquí cuando estén publicados.</p><a class="travel-button" href="/destinos/">Explorar las historias →</a></section>}</main><Footer/></body></html>
