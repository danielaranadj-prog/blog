---
import BaseHead from '../components/BaseHead.astro';
import BlogHeader from '../components/BlogHeader.astro';
import Footer from '../components/Footer.astro';
import settings from '../data/site-settings.json';
import { DEFAULT_AUTHOR } from '../data/authors';
const {title,description,eyebrow='Información del sitio',summary='',profile=false}=Astro.props;
const links=[['/sobre-mi','Sobre nosotros'],['/cookies','Cookies'],['/legal/privacidad','Privacidad'],['/legal/terminos','Términos de uso']];
const current=Astro.url.pathname.replace(/\/$/,'');
---
<html lang="es">
<head>
<BaseHead title={`${title} | ${settings.name}`} description={description} permalink={new URL(Astro.url.pathname,Astro.site||'https://www.instantetrips.com').href}/>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
</head>
<body>
<BlogHeader/>
<main class="editorial-page">
<a class="back-link" href="/">← Volver a las historias</a>
<header class:list={['page-heading',{profile}]}>
<div><span class="eyebrow">INSTANTE / {eyebrow}</span><h1>{title}</h1>{summary&&<p class="summary">{summary}</p>}</div>
{profile&&<figure class="portrait"><img src={DEFAULT_AUTHOR.image} alt={DEFAULT_AUTHOR.name} width="136" height="136"/><figcaption>{DEFAULT_AUTHOR.name}<span>Creador de Instante Trips</span></figcaption></figure>}
</header>
<div class="page-grid">
<aside class="page-sidebar"><span class="eyebrow">Conoce el proyecto</span><nav aria-label="Información de Instante Trips">{links.map(([url,label])=><a href={url} aria-current={current===url?'page':undefined}>{label}<span aria-hidden="true">↗</span></a>)}</nav><p>Viajes reales.<br/>Información clara.<br/>Decisiones propias.</p></aside>
<article class="page-content"><slot/></article>
</div>
<div class="page-end"><span>INSTANTE · TRIPS & TIPS</span><a href="/#explorar">Seguir explorando →</a></div>
</main>
<Footer/>
</body>
</html>
<style is:global>
:root{--font-serif:'Fraunces',Georgia,serif;--font-sans:'Plus Jakarta Sans',sans-serif;--font-body:var(--font-sans);--bg-page:#FAF7F2;--text-main:#18181B;--text-prose:#353538;--text-muted:#736D64;--accent-terracotta:#E04F16;--accent-terracotta-hover:#C23E0B}
body{margin:0;background:#FAF7F2;color:#18181B;font-family:var(--font-sans)}
.editorial-page{max-width:1180px;margin:0 auto;padding:2.5rem 20px 0}.back-link{font-size:.75rem;font-weight:700;color:#736D64;text-decoration:none}.back-link:hover{color:#E04F16}.page-heading{padding:2.5rem 0 2.75rem;border-bottom:2px solid #18181B;margin-bottom:2rem}.eyebrow{font-size:.65rem;letter-spacing:.14em;text-transform:uppercase;font-weight:800;color:#C23E0B}.page-heading h1{font-family:var(--font-serif);font-weight:800;font-size:clamp(2.5rem,5vw,4.5rem);letter-spacing:-.045em;line-height:1.08;margin:.8rem 0 1rem;color:#18181B}.summary{font-size:1.05rem;line-height:1.8;max-width:700px;color:#736D64;margin:0}.page-heading.profile{display:grid;grid-template-columns:minmax(0,1fr) 180px;gap:3rem;align-items:center}.portrait{margin:0;text-align:center}.portrait img{width:136px;height:136px;object-fit:cover;border-radius:18px;border:1.5px solid #18181B;box-shadow:0 4px 0 #18181b14}.portrait figcaption{font-weight:800;font-size:.8rem;margin-top:.7rem}.portrait figcaption span{display:block;font-weight:400;color:#736D64;font-size:.65rem;margin-top:.25rem}.page-grid{display:grid;grid-template-columns:210px minmax(0,1fr);gap:2.5rem;align-items:start}.page-sidebar{position:sticky;top:110px;min-width:0;padding-top:.7rem}.page-sidebar nav{display:grid;margin:1rem 0;border-top:1px solid #D6D1C4}.page-sidebar nav a{display:flex;justify-content:space-between;gap:1rem;padding:.85rem .6rem;border-bottom:1px solid #D6D1C4;color:#18181B;font-size:.78rem;font-weight:600;text-decoration:none}.page-sidebar nav a[aria-current=page]{background:#18181B;color:#FAF7F2;border-radius:7px}.page-sidebar p{font-family:var(--font-serif);color:#736D64;font-size:1.1rem;line-height:1.6;margin-top:1.5rem}.page-content{min-width:0;background:#FDFBF7;border:1.5px solid #18181B;border-radius:16px;padding:clamp(1.25rem,3vw,2.75rem);box-shadow:0 4px 0 #18181b12;overflow-wrap:anywhere}.page-content p,.page-content li{font-size:.94rem;line-height:1.95;color:#353538}.page-content p{margin:0 0 1.2rem}.page-content h2{font:700 clamp(1.45rem,2.5vw,1.9rem)/1.25 var(--font-serif);letter-spacing:-.025em;margin:2.5rem 0 1rem;color:#18181B}.page-content h2:first-child,.about-section:first-child h2{margin-top:0}.page-content h3{font-family:var(--font-serif);font-size:1.35rem}.page-content ul{padding-left:1.3rem;margin:1rem 0 1.5rem}.page-content li{padding-left:.2rem;margin:.35rem 0}.page-content li::marker{color:#E04F16}.page-content a{color:#C23E0B;text-underline-offset:3px}.page-content a:focus-visible,.page-sidebar a:focus-visible,.page-end a:focus-visible,.back-link:focus-visible{outline:3px solid #E04F16;outline-offset:4px}.page-content strong{font-weight:800;color:#18181B}.stage-item{border-left:3px solid #E04F16;background:#F3EFE6;padding:1rem 1.25rem;margin:.8rem 0;border-radius:0 10px 10px 0}.stage-title{display:block;font-weight:800;margin-bottom:.3rem}.stage-desc{font-size:.86rem;line-height:1.8;color:#736D64}.highlight{background:#F3EFE6;padding:0 .2rem}.collaborator-box{border:1px dashed #736D64;background:#F3EFE6;padding:1.5rem;border-radius:12px;margin:1.5rem 0}.page-content .contact-cta{display:inline-flex;background:#E04F16;border:1.5px solid #18181B;box-shadow:0 3px 0 #18181b15;border-radius:999px;color:#fff;padding:.7rem 1.5rem;text-decoration:none;font-weight:800}.page-end{display:flex;align-items:center;justify-content:space-between;gap:1rem;border-top:1px solid #D6D1C4;margin-top:3rem;padding:1.5rem 0}.page-end span{font-size:.65rem;letter-spacing:.12em;font-weight:800;color:#736D64}.page-end a{font-size:.8rem;color:#C23E0B;font-weight:700;text-decoration:none}
@media(max-width:760px){.editorial-page{padding:1.5rem 16px 0}.page-heading{padding:1.75rem 0;margin-bottom:1.25rem}.page-grid{grid-template-columns:minmax(0,1fr);gap:1.25rem}.page-sidebar{position:static;padding:0}.page-sidebar>.eyebrow,.page-sidebar>p{display:none}.page-sidebar nav{display:flex;overflow:auto;gap:.5rem;border:0;margin:0;padding-bottom:.5rem}.page-sidebar nav a{white-space:nowrap;border:1px solid #D6D1C4;border-radius:999px;padding:.6rem .9rem}.page-sidebar nav a span{display:none}.page-heading.profile{grid-template-columns:minmax(0,1fr);gap:1.5rem}.portrait{display:flex;align-items:center;gap:1rem;text-align:left}.portrait img{width:80px;height:80px;border-radius:12px}.portrait figcaption{margin:0}.summary{font-size:.93rem}.page-end{align-items:flex-start}.page-end span{max-width:130px}}
</style>
