---
// Component Imports
import BaseHead from '../components/BaseHead.astro';
import BlogHeader from '../components/BlogHeader.astro';
import Footer from '../components/Footer.astro';
import QuickSummaryBox from '../components/QuickSummaryBox.astro';
import LeadMagnetBanner from '../components/LeadMagnetBanner.astro';

import type { Author } from '../data/authors';
import { AUTHORS, DEFAULT_AUTHOR } from '../data/authors';

const {
  content = {},
  frontmatter = {},
  headings = [],
} = Astro.props;

/* -----------------------------
   DATOS DEL POST
----------------------------- */
const post = {
  title: frontmatter.title || content.title,
  description: frontmatter.description || content.description,
  publishDate: frontmatter.publishDate || content.publishDate,
  heroImage: frontmatter.heroImage || content.heroImage,
  heroImageLink: frontmatter.heroImageLink || content.heroImageLink,
  alt: frontmatter.alt || content.alt || frontmatter.title,
  tags: frontmatter.tags || content.tags || [],
  quickSummary: frontmatter.quickSummary || content.quickSummary,

  // slug del autor desde markdown
  authorSlug: frontmatter.author,
};

/* -----------------------------
   AUTOR (DINÁMICO + FALLBACK)
----------------------------- */
const author: Author =
  (post.authorSlug && AUTHORS[post.authorSlug]) || DEFAULT_AUTHOR;

const finalImage = post.heroImage || post.heroImageLink;
const permalink = Astro.url.href;

/* -----------------------------
   INTERLINKING INTELIGENTE (POSTS RELACIONADOS)
----------------------------- */
const allPosts = await Astro.glob('../pages/posts/*.md');
const currentPath = decodeURIComponent(Astro.url.pathname).replace(/\/$/, '');
const currentTitle = (post.title || '').trim().toLowerCase();
const currentTags = (post.tags || []).map((t: string) => t.toLowerCase());

// Filtrar el post actual de manera robusta
const otherPosts = allPosts.filter((p) => {
  const pPath = decodeURIComponent(p.url || '').replace(/\/$/, '');
  const pTitle = (p.frontmatter.title || '').trim().toLowerCase();
  return pPath !== currentPath && pTitle !== currentTitle;
});

// Puntuación de afinidad por país/tags/categoría
const scoredPosts = otherPosts.map((p) => {
  const pTags = (p.frontmatter.tags || []).map((t: string) => t.toLowerCase());
  const pTitle = (p.frontmatter.title || '').toLowerCase();
  let score = 0;

  currentTags.forEach((t: string) => {
    if (pTags.includes(t)) score += 3;
    if (pTitle.includes(t)) score += 2;
  });

  const isSpain = currentTags.some((t: string) => ['españa', 'madrid', 'barcelona', 'segovia', 'europa'].includes(t)) ||
    post.title.toLowerCase().includes('barcelona') || post.title.toLowerCase().includes('madrid') || post.title.toLowerCase().includes('segovia');
  
  if (isSpain && (pTags.some((t: string) => ['españa', 'madrid', 'barcelona', 'segovia', 'europa'].includes(t)) || 
      pTitle.includes('madrid') || pTitle.includes('segovia') || pTitle.includes('barcelona') || pTitle.includes('tren'))) {
    score += 4;
  }

  const isArg = currentTags.some((t: string) => ['argentina', 'patagonia', 'chalten', 'pampa'].includes(t)) ||
    post.title.toLowerCase().includes('patagonia') || post.title.toLowerCase().includes('argentina') || post.title.toLowerCase().includes('pampa');
  
  if (isArg && (pTags.some((t: string) => ['argentina', 'patagonia', 'chalten', 'pampa'].includes(t)) || 
      pTitle.includes('patagonia') || pTitle.includes('argentina') || pTitle.includes('pampa'))) {
    score += 4;
  }

  return { post: p, score };
});

scoredPosts.sort((a, b) => b.score - a.score || new Date(b.post.frontmatter.publishDate).valueOf() - new Date(a.post.frontmatter.publishDate).valueOf());
const relatedPosts = scoredPosts.slice(0, 3).map((item) => item.post);

/* -----------------------------
   HEADINGS PARA ÍNDICE DEL VIAJE
----------------------------- */
const tocHeadings = (headings && headings.length > 0)
  ? headings.filter((h: any) => h.depth === 2 || h.depth === 3).slice(0, 6)
  : [
      { text: "1. Cómo llegar y ahorrar en transporte", slug: "1-la-mejor-alternativa-al-metro-tren-de-alta-velocidad-o-aerobus" },
      { text: "2. Visitas sin agobios ni reventas", slug: "2-visitas-sin-agobios-ni-reventas-callejeras" },
      { text: "3. La libertad de cambiar de rumbo", slug: "3-la-libertad-de-cambiar-de-rumbo-plan-b" },
    ];

/* -----------------------------
   DATOS ESTRUCTURADOS JSON-LD
----------------------------- */
const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": `${permalink}#article`,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://blog.instantetrips.com/#website",
        "name": "Instante Trips & Tips",
        "url": "https://blog.instantetrips.com"
      },
      "headline": post.title,
      "description": post.description,
      "image": finalImage ? [finalImage] : undefined,
      "datePublished": post.publishDate ? new Date(post.publishDate).toISOString() : new Date().toISOString(),
      "dateModified": post.publishDate ? new Date(post.publishDate).toISOString() : new Date().toISOString(),
      "inLanguage": "es-ES",
      "mainEntityOfPage": permalink,
      "author": {
        "@type": "Person",
        "name": author.name,
        "url": "https://blog.instantetrips.com"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Instante Trips & Tips",
        "logo": {
          "@type": "ImageObject",
          "url": "https://blog.instantetrips.com/logo.svg"
        }
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${permalink}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://blog.instantetrips.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": post.title,
          "item": permalink
        }
      ]
    }
  ]
};
---

<html lang="es">
<head>
  <BaseHead
    title={`${post.title} | Instante Trips`}
    description={post.description}
    permalink={permalink}
    image={finalImage}
  />

  <!-- Schema.org JSON-LD para Google Search y Discover -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <style>
    .post-page-shell {
      max-width: 1220px;
      margin: 0 auto;
      padding: 1.5rem 1.5rem 5rem;
      box-sizing: border-box;
    }

    /* --- LAYOUT 2 COLUMNAS (minmax(0, 1fr) 340px, gap 3rem) --- */
    .article-two-cols-layout {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2.5rem;
      margin-top: 1.5rem;
    }

    @media (min-width: 1024px) {
      .article-two-cols-layout {
        grid-template-columns: minmax(0, 1fr) 340px;
        align-items: start;
        gap: 3rem;
      }
    }

    /* --- CONTENEDOR PRINCIPAL DEL ARTÍCULO --- */
    .article-main-surface {
      background: var(--card-bg, #FFFFFF);
      border: 1px solid var(--card-border, #E6E1D6);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: var(--card-shadow, 0 4px 20px rgba(0, 0, 0, 0.04));
    }

    .article-hero-wrap {
      width: 100%;
      height: 280px;
      overflow: hidden;
      background: #E6E1D6;
      position: relative;
    }

    @media (min-width: 768px) {
      .article-hero-wrap {
        height: 420px;
      }
    }

    .article-hero-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    .article-inner-padding {
      padding: 1.75rem 1.5rem 3.5rem;
    }

    @media (min-width: 768px) {
      .article-inner-padding {
        padding: 3rem 3.5rem 4rem;
      }
    }

    /* BREADCRUMB */
    .article-breadcrumb {
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-sans);
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-bottom: 1.25rem;
    }

    .breadcrumb-link {
      color: var(--text-main);
      text-decoration: none;
      font-weight: 700;
    }

    .breadcrumb-link:hover {
      color: var(--accent-terracotta);
    }

    /* TITULAR H1 */
    .article-headline-serif {
      font-family: var(--font-serif);
      font-size: clamp(2rem, 3.8vw, 3rem);
      font-weight: 900;
      line-height: 1.15;
      color: var(--text-main);
      margin: 0 0 1rem;
      letter-spacing: -0.02em;
    }

    .article-meta-bar {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      padding-bottom: 1.5rem;
      margin-bottom: 2rem;
      border-bottom: 1px solid var(--card-border);
      font-family: var(--font-sans);
      font-size: 0.82rem;
      color: var(--text-muted);
      font-weight: 600;
    }

    .author-chip {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-weight: 700;
      color: var(--text-main);
    }

    .author-chip-avatar {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      object-fit: cover;
    }

    /* FIRMA DEL AUTOR */
    .signature-card-box {
      margin-top: 4rem;
      padding: 2rem;
      background: var(--bg-page);
      border: 1px solid var(--card-border);
      border-radius: 14px;
      display: flex;
      align-items: center;
      gap: 1.25rem;
    }

    .signature-avatar {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      object-fit: cover;
      flex-shrink: 0;
      border: 2px solid var(--accent-terracotta);
    }

    .signature-name {
      font-family: var(--font-serif);
      margin: 0 0 0.35rem;
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--text-main);
    }

    .signature-bio {
      margin: 0;
      font-family: var(--font-sans);
      font-size: 0.88rem;
      color: var(--text-muted);
      line-height: 1.5;
    }

    /* ARTÍCULOS RELACIONADOS */
    .related-section {
      margin: 3.5rem 0 1.5rem;
      padding-top: 2.5rem;
      border-top: 1px solid var(--card-border);
    }

    .related-eyebrow {
      font-family: var(--font-sans);
      font-size: 0.78rem;
      font-weight: 800;
      color: var(--accent-terracotta);
      text-transform: uppercase;
      letter-spacing: 1px;
      display: block;
      margin-bottom: 0.4rem;
    }

    .related-heading-serif {
      font-family: var(--font-serif);
      font-size: 1.6rem;
      font-weight: 800;
      margin: 0 0 1.5rem;
      color: var(--text-main);
    }

    .related-cards-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    @media (min-width: 680px) {
      .related-cards-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    .related-mini-card {
      background: #FFFFFF;
      border: 1px solid var(--card-border);
      border-radius: 12px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      text-decoration: none;
      color: inherit;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .related-mini-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--card-shadow);
      border-color: #D4CDBD;
    }

    .related-mini-img {
      width: 100%;
      height: 140px;
      object-fit: cover;
      display: block;
    }

    .related-mini-body {
      padding: 1rem;
      display: flex;
      flex-direction: column;
      gap: 6px;
      flex-grow: 1;
    }

    .related-mini-date {
      font-family: var(--font-sans);
      font-size: 0.72rem;
      color: var(--text-muted);
      text-transform: uppercase;
      font-weight: 700;
    }

    .related-mini-title {
      font-family: var(--font-serif);
      font-size: 0.95rem;
      font-weight: 800;
      line-height: 1.35;
      color: var(--text-main);
      margin: 0;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* --- SIDEBAR STICKY (340px) --- */
    .article-sticky-sidebar {
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
    }

    @media (min-width: 1024px) {
      .article-sticky-sidebar {
        position: sticky;
        top: 5.5rem;
        z-index: 10;
      }
    }
  </style>
</head>

<body>
  <BlogHeader />

  <div class="post-page-shell">
    <div class="article-two-cols-layout">

      <!-- COLUMNA PRINCIPAL DE CONTENIDO (70%) -->
      <main class="article-main-surface">
        {finalImage && (
          <div class="article-hero-wrap">
            <img
              src={finalImage}
              alt={post.alt}
              class="article-hero-img"
              loading="eager"
              fetchpriority="high"
              width="1200"
              height="630"
            />
          </div>
        )}

        <article class="article-inner-padding">
          <nav class="article-breadcrumb" aria-label="Ruta de navegación">
            <a href="/" class="breadcrumb-link">Inicio</a>
            <span>/</span>
            <span>{post.tags[0] || 'Guías'}</span>
          </nav>

          <h1 class="article-headline-serif">{post.title}</h1>

          <div class="article-meta-bar">
            <div class="author-chip">
              <img src={author.image} alt="" aria-hidden="true" class="author-chip-avatar" />
              <span>Por {author.name}</span>
            </div>
            <span>•</span>
            <time datetime={post.publishDate}>
              {new Date(post.publishDate).toLocaleDateString('es-ES', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </time>
            <span>•</span>
            <span>4 min de lectura</span>
          </div>

          <!-- TL;DR TICKET COMPONENT -->
          <QuickSummaryBox 
            budget={post.quickSummary?.budget || "7€ - 15€"}
            bestSeason={post.quickSummary?.bestSeason || "Todo el año"}
            pitfall={post.quickSummary?.pitfall || "No reservar online con antelación"}
            ctaText={post.quickSummary?.ctaText || "Descargar itinerario completo"}
            ctaLink={post.quickSummary?.ctaLink || "https://www.omio.com"}
          />

          <!-- CUERPO DEL POST -->
          <div class="prose">
            <slot />
          </div>

          <!-- LEAD MAGNET IN-CONTENT -->
          <LeadMagnetBanner />

          <!-- FIRMA EDITORIAL -->
          <div class="signature-card-box">
            <img src={author.image} alt={author.name} class="signature-avatar" />
            <div>
              <h4 class="signature-name">Escrito por {author.name}</h4>
              <p class="signature-bio">{author.bio}</p>
            </div>
          </div>

          <!-- POSTS RELACIONADOS INTELIGENTES -->
          {relatedPosts.length > 0 && (
            <section class="related-section" aria-label="Artículos recomendados">
              <span class="related-eyebrow">SIGUE LEYENDO</span>
              <h3 class="related-heading-serif">Guías que te van a ahorrar dinero y tiempo</h3>
              <div class="related-cards-grid">
                {relatedPosts.map((r) => {
                  const rImg = r.frontmatter.heroImage || r.frontmatter.heroImageLink;
                  return (
                    <a href={r.url} class="related-mini-card">
                      {rImg && (
                        <img 
                          src={rImg} 
                          alt="" 
                          aria-hidden="true" 
                          loading="lazy" 
                          class="related-mini-img" 
                          width="300"
                          height="140"
                        />
                      )}
                      <div class="related-mini-body">
                        <span class="related-mini-date">
                          {new Date(r.frontmatter.publishDate).toLocaleDateString('es-ES', {
                            month: 'short',
                            day: 'numeric'
                          })}
                        </span>
                        <h4 class="related-mini-title">{r.frontmatter.title}</h4>
                      </div>
                    </a>
                  );
                })}
              </div>
            </section>
          )}
        </article>
      </main>

      <!-- SIDEBAR DERECHO REALMENTE STICKY (30% / 340px) -->
      <aside class="article-sticky-sidebar" aria-label="Barra lateral">
        
        <!-- WIDGET A: ÍNDICE DEL VIAJE (TIMELINE VERTICAL CON ACENTO ACTIVO NARANJA) -->
        <div class="toc-card-widget">
          <h4 class="toc-widget-title">Índice del viaje</h4>
          <ol class="toc-timeline-list" id="articleTocList">
            {tocHeadings.map((h: any, idx: number) => (
              <li class={`toc-timeline-item ${idx === 0 ? 'active' : ''}`}>
                <span class="toc-dot"></span>
                <a href={`#${h.slug}`}>{idx + 1}. {h.text}</a>
              </li>
            ))}
          </ol>
        </div>

        <!-- WIDGET B: TARJETA NATIVA DE DESCUENTO EN SEGURO DE VIAJE (MOCKUP 2) -->
        <div class="insurance-card-widget">
          <span class="insurance-medal-icon" aria-hidden="true">🎖️</span>
          <h4 class="insurance-title">5% Descuento en Seguro de Viaje</h4>
          <p class="insurance-text">
            Cobertura médica completa, cancelación sin franquicia y repatriación en español 24/7.
          </p>
          <a 
            href="https://www.iatiseguros.com" 
            target="_blank" 
            rel="sponsored nofollow noopener" 
            class="insurance-calc-btn"
          >
            Calcular Descuento
          </a>
        </div>

      </aside>

    </div>
  </div>

  <Footer />

  <script is:inline>
    // Sincronización del TOC activo con el scroll
    document.addEventListener('DOMContentLoaded', () => {
      const headings = document.querySelectorAll('.prose h2, .prose h3');
      const tocItems = document.querySelectorAll('.toc-timeline-item');
      
      if (headings.length > 0 && tocItems.length > 0) {
        window.addEventListener('scroll', () => {
          let currentIdx = 0;
          const scrollPos = window.scrollY + 180;
          
          headings.forEach((h, i) => {
            if (h.offsetTop <= scrollPos) {
              currentIdx = i;
            }
          });

          tocItems.forEach((item, i) => {
            if (i === currentIdx) {
              item.classList.add('active');
            } else {
              item.classList.remove('active');
            }
          });
        });
      }
    });
  </script>
</body>
</html>