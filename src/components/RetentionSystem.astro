---
import settings from '../data/site-settings.json';
import TravelIcon from './TravelIcon.astro';
const {articleTitle='',articleUrl='',articleCategory='Viajes'}=Astro.props;
---
<div class="reading-progress-container" aria-hidden="true"><div class="reading-progress-bar" id="readingProgressBar"></div></div>
{settings.tools?.savedRoutes!==false&&<div class="save-route-action-bar"><button type="button" class="travel-button" id="saveToRouteBtn" data-title={articleTitle} data-url={articleUrl} data-category={articleCategory} aria-pressed="false" disabled><TravelIcon/><span data-save-text>Guardar en Mi Ruta</span></button><a href="/mi-ruta" class="view-route-link">Ver mis guías →</a><span id="save-route-status" role="status"></span></div>}
<script>
import {readSavedRoutes,writeSavedRoutes,normalizeRoute} from '../utils/saved-routes.mjs';
const button=document.querySelector<HTMLButtonElement>('#saveToRouteBtn');
const getList=()=>{try{return readSavedRoutes(localStorage);}catch{return [];}};
const sync=()=>{
  const saved=getList().some(item=>item.url===button?.dataset.url?.replace(/\/$/,''));
  button?.setAttribute('aria-pressed',String(saved));
  const text=button?.querySelector('[data-save-text]');if(text)text.textContent=saved?'Guardada en Mi Ruta':'Guardar en Mi Ruta';
};
if(button){
  button.disabled=false;sync();
  button.addEventListener('click',()=>{
    const items=getList(),route=normalizeRoute({url:button.dataset.url,title:button.dataset.title,category:button.dataset.category,savedAt:Date.now()});
    if(!route)return;
    const exists=items.some(item=>item.url===route.url);
    const next=exists?items.filter(item=>item.url!==route.url):[...items,route];
    let ok=false;try{ok=next.length<=200&&writeSavedRoutes(localStorage,next);}catch{}
    const status=document.querySelector('#save-route-status');
    if(status)status.textContent=ok?(exists?'Guía quitada de tu lista.':'Guía guardada en este navegador.'):'No se pudo guardar. Comprueba el almacenamiento del navegador o libera espacio en tu lista.';
    sync();window.dispatchEvent(new Event('instante-route-change'));
  });
  window.addEventListener('storage',sync);
}
const bar=document.querySelector<HTMLElement>('#readingProgressBar'),prose=document.querySelector<HTMLElement>('.prose');
let pending=false;
function progress(){
  pending=false;if(!bar||!prose)return;
  const start=prose.getBoundingClientRect().top+window.scrollY;
  const distance=Math.max(1,prose.offsetHeight-window.innerHeight+160);
  bar.style.width=`${Math.max(0,Math.min(100,(window.scrollY-start+160)/distance*100))}%`;
}
window.addEventListener('scroll',()=>{if(!pending){pending=true;requestAnimationFrame(progress);}},{passive:true});
window.addEventListener('resize',progress);progress();
</script>
<style>
.reading-progress-container{position:fixed;top:0;left:0;width:100%;height:3px;z-index:1100;pointer-events:none}.reading-progress-bar{height:100%;width:0;background:var(--accent-terracotta)}.save-route-action-bar{display:flex;flex-wrap:wrap;align-items:center;gap:.8rem 1rem;margin:1.5rem 0}.save-route-action-bar button[aria-pressed=true]{background:var(--surface-muted);color:var(--accent-ink)}.save-route-action-bar button:disabled{opacity:.5}.view-route-link{font-size:.75rem;font-weight:700;color:var(--text-secondary);text-underline-offset:4px}#save-route-status{flex-basis:100%;font-size:.7rem;color:var(--text-secondary);line-height:1.6}#save-route-status:empty{display:none}
</style>
