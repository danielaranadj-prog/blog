---
const today = new Date();
---

<footer class="editorial-site-footer">
    <div class="footer-container">
        <div class="footer-col">
            <span class="footer-brand-title">INSTANTE TRIPS</span>
            <p class="footer-desc">
                Guías de viaje reales, sin filtros y directo al grano. Probamos cada ruta en persona.
            </p>
        </div>

        <div class="footer-col">
            <h4 class="footer-title">Explorar</h4>
            <ul class="footer-links">
                <li><a href="/">Inicio</a></li>
                <li><a href="/#explorar">Destinos & Categorías</a></li>
                <li><a href="/posts/barcelona-10-minutos-de-terror-y-lo-único-que-me-salvó">Historias Reales</a></li>
            </ul>
        </div>

        <div class="footer-col">
            <h4 class="footer-title">Síguenos</h4>
            <div class="social-links">
                <a href="#" target="_blank" rel="noopener">Instagram</a>
                <a href="#" target="_blank" rel="noopener">X / Twitter</a>
                <a href="#" target="_blank" rel="noopener">YouTube</a>
            </div>
        </div>
    </div>
    <div class="copyright-bar">
        &copy; {today.getFullYear()} Daniel Arana — Instante Trips & Tips. Todos los derechos reservados.
    </div>
</footer>

<style>
    .editorial-site-footer {
        background-color: var(--dark-authority, #18181B);
        color: #E4E4E7;
        padding: 4.5rem 0 2rem 0;
        margin-top: 5rem;
        border-top: 3px solid var(--accent-terracotta, #D95D24);
        font-family: var(--font-sans);
    }
    .footer-container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 1.5rem;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 3rem;
    }
    .footer-brand-title {
        font-family: var(--font-serif);
        font-size: 1.4rem;
        font-weight: 900;
        color: #FFFFFF;
        letter-spacing: -0.02em;
        display: block;
        margin-bottom: 0.8rem;
    }
    .footer-desc {
        font-size: 0.88rem;
        color: #A1A1AA;
        line-height: 1.6;
        margin: 0;
    }
    .footer-title {
        color: #FFFFFF;
        text-transform: uppercase;
        margin-top: 0;
        margin-bottom: 1.2rem;
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 1px;
    }
    .footer-links {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    .footer-links li {
        margin-bottom: 0.75rem;
    }
    .footer-links a, .social-links a {
        color: #A1A1AA;
        text-decoration: none;
        font-size: 0.88rem;
        transition: color 0.15s ease;
    }
    .footer-links a:hover, .social-links a:hover {
        color: var(--accent-terracotta, #D95D24);
    }
    .social-links {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }
    .copyright-bar {
        text-align: center;
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        font-size: 0.8rem;
        color: #71717A;
    }
</style>