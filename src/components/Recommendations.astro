---
import settings from '../data/site-settings.json';
const {tags=[],catalog=settings.catalog}=Astro.props;
const normalize=value=>String(value).normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
const normalized=normalize(tags.join(' '));
const items=(catalog||[]).filter(i=>i.enabled&&i.confirmed&&i.placement!=='manual'&&(!i.tags||i.tags.split(',').some(t=>t.trim()&&normalized.includes(normalize(t.trim()))))).slice(0,3);
const iconPaths={activity:'M12 21s-7-4.5-7-11a7 7 0 1 1 14 0c0 6.5-7 11-7 11z M9 10a3 3 0 1 0 6 0a3 3 0 1 0-6 0',stay:'M3 18V7 M21 18V7 M3 13h18 M3 18h18 M7 13V9h4v4 M13 13V9h4v4',transport:'M6 17h12V5H6z M8 9h8 M9 17l-2 4 M15 17l2 4 M8 13h1 M15 13h1',insurance:'M12 3l8 3v6c0 5-8 9-8 9s-8-4-8-9V6z M8 12l3 3 5-6',resource:'M6 3h8l4 4v14H6z M14 3v5h4 M9 12h6 M9 16h6'};
---
{items.length>0&&<section class="recommendations" aria-label="Recursos y recomendaciones"><h3 class="recommendations-heading">Para preparar tu viaje</h3>
{items.map((item,index)=>{
 const category=item.type==='download'?'resource':item.category||'activity';
 const image=item.image&&/^(https:\/\/|\/(?!\/))/.test(item.image)?item.image:'';
 return <article class:list={['recommendation-card',{'recommendation-featured':index===0,'recommendation-compact':index>0}]}>
  <div class:list={['recommendation-art',`recommendation-${category}`,{'recommendation-photo':!!image}]}>
   {image?<img src={image} alt="" loading="lazy" width="600" height="340"/>:<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={iconPaths[category]||iconPaths.activity}/></svg>}
   {index===0&&!image&&<span>{item.type==='download'?'PARA LLEVAR CONTIGO':'PARA TU PRÓXIMO VIAJE'}</span>}
  </div>
  <div class="recommendation-copy"><span class="recommendation-label">{item.type==='affiliate'?'ENLACE DE AFILIACIÓN':'RECURSO DESCARGABLE'}{item.provider&&` · ${item.provider}`}</span><h4>{item.title}</h4>{item.text&&<p>{item.text}</p>}<a href={item.url} data-catalog-id={item.id} data-track={item.type==='affiliate'?'affiliate_click':'download_click'} target="_blank" rel={item.type==='affiliate'?'sponsored nofollow noopener':'noopener'}>{item.button||(item.type==='affiliate'?'Consultar disponibilidad':'Descargar PDF')} <span aria-hidden="true">→</span></a></div>
 </article>;
})}
{items.some(i=>i.type==='affiliate')&&<p class="recommendations-disclosure">Enlaces de afiliación. Podemos recibir una comisión si reservas. Consulta el precio y las condiciones en el proveedor.</p>}</section>}
<style>
.recommendations{min-width:0;font-family:var(--font-sans,'Plus Jakarta Sans',sans-serif)}.recommendations-heading{font:700 1.4rem/1.2 var(--font-serif,Georgia,serif);letter-spacing:-.025em;margin:0 0 1rem}.recommendation-card{min-width:0;overflow:hidden;border:1.5px solid #18181B;border-radius:12px;background:#FDFBF7;margin:1rem 0;box-shadow:0 3px 0 #18181b0c}.recommendation-art{background:#E3E7DD;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;padding:22px;min-height:130px;color:#18181B}.recommendation-art svg{width:38px;height:38px}.recommendation-art>span{font-size:.62rem;font-weight:700;letter-spacing:.1em;text-align:center}.recommendation-stay{background:#E6E0D5}.recommendation-transport{background:#DEE4E8}.recommendation-insurance,.recommendation-resource{background:#F3EFE6}.recommendation-photo{padding:0}.recommendation-photo img{display:block;width:100%;height:155px;object-fit:cover}.recommendation-copy{padding:1.15rem;min-width:0;overflow-wrap:anywhere}.recommendation-label{display:block;color:#736D64;font-size:.6rem;line-height:1.7;letter-spacing:.07em;font-weight:800}.recommendation-copy h4{font:700 1.4rem/1.15 var(--font-serif,Georgia,serif);letter-spacing:-.025em;margin:.7rem 0}.recommendation-copy p{font-size:.8rem;line-height:1.75;margin:0 0 1rem;color:#5F5B55}.recommendation-copy a{display:flex;justify-content:center;align-items:center;gap:.5rem;text-decoration:none;background:#E04F16;color:#fff;border:1px solid #18181B;border-radius:999px;padding:.75rem 1rem;font-size:.75rem;line-height:1.5;font-weight:800;min-height:44px}.recommendation-copy a:hover{background:#C23E0B}.recommendation-copy a:focus-visible{outline:3px solid #E04F16;outline-offset:4px}.recommendation-compact{display:grid;grid-template-columns:45px minmax(0,1fr);gap:12px;padding:15px;background:#F3EFE6}.recommendation-compact .recommendation-art{padding:0;min-height:0;align-self:start;border-radius:7px;background:transparent}.recommendation-compact .recommendation-art svg{width:28px;height:28px}.recommendation-compact .recommendation-photo img{width:45px;height:55px;border-radius:6px}.recommendation-compact .recommendation-copy{padding:0}.recommendation-compact h4{font-size:1.15rem;margin:.45rem 0}.recommendation-compact .recommendation-copy p{font-size:.75rem;margin-bottom:.6rem}.recommendation-compact a{display:inline-flex;justify-content:flex-start;background:none;color:#B83C11;border:0;border-radius:0;padding:.35rem 0;text-decoration:underline;text-underline-offset:3px}.recommendation-compact a:hover{background:none;color:#18181B}.recommendations-disclosure{font-size:.68rem;line-height:1.8;color:#736D64;margin:1rem 0 0}
@media(max-width:1023px){.recommendations{max-width:100%}.recommendation-featured .recommendation-art{min-height:150px}.recommendation-featured .recommendation-photo img{height:190px}}
</style>
