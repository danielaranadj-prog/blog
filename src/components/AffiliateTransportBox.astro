---
export interface Props {
  operator1?: string;
  operator2?: string;
  price1?: string;
  price2?: string;
  duration1?: string;
  duration2?: string;
  affiliateUrl?: string;
  ctaText?: string;
}

const {
  operator1 = "OUIGO",
  operator2 = "avlo",
  price1 = "Desde 9€",
  price2 = "Desde 7€",
  duration1 = "2h 30m",
  duration2 = "2h 25m",
  affiliateUrl = "https://www.omio.com",
  ctaText = "Buscar billetes desde 7€"
} = Astro.props;
---

<div class="transport-comparison-card" aria-label="Comparativa de trenes de alta velocidad">
  <!-- OPERATOR LOGOS HEADER -->
  <div class="comp-header-logos">
    <span class="logo-ouigo-pill">{operator1}</span>
    <span class="comp-vs-txt">vs.</span>
    <span class="logo-avlo-brand">{operator2}</span>
  </div>

  <!-- COMPARISON COLUMNS -->
  <div class="comp-columns-grid">
    <div class="comp-col-card">
      <span class="comp-col-subtitle">Ouigo Alta Velocidad</span>
      <span class="comp-col-price">{price1}</span>
      <span class="comp-col-duration">⏱️ {duration1}</span>
    </div>

    <div class="comp-col-card comp-col-card--highlight">
      <span class="comp-col-subtitle">Avlo Low-Cost Renfe</span>
      <span class="comp-col-price comp-col-price--best">{price2}</span>
      <span class="comp-col-duration">⏱️ {duration2}</span>
    </div>
  </div>

  <!-- FULL WIDTH TERRACOTTA CTA -->
  <a 
    href={affiliateUrl} 
    target="_blank" 
    rel="sponsored nofollow noopener"
    class="transport-terracotta-button"
  >
    <span>{ctaText}</span>
    <span class="btn-arrow" aria-hidden="true">→</span>
  </a>

  <div class="transport-disclaimer-row">
    <small>* Enlace patrocinado oficial sin comisiones extra. Precios comprobados en tiempo real.</small>
  </div>
</div>

<style>
  .transport-comparison-card {
    margin: 2.5rem 0;
    background: #FFFFFF;
    border: 1px solid var(--card-border, #E6E1D6);
    border-radius: 16px;
    padding: 1.75rem;
    box-shadow: var(--card-shadow, 0 4px 20px rgba(0, 0, 0, 0.04));
    max-width: 460px;
    margin-left: auto;
    margin-right: auto;
  }

  .comp-header-logos {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--card-border, #E6E1D6);
  }

  .logo-ouigo-pill {
    background: #E5007D;
    color: #FFFFFF;
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: 0.82rem;
    padding: 0.35rem 0.85rem;
    border-radius: 20px;
    letter-spacing: 0.5px;
    line-height: 1;
  }

  .comp-vs-txt {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-muted, #71717A);
    text-transform: lowercase;
  }

  .logo-avlo-brand {
    color: #6C1D6E;
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: 1.3rem;
    letter-spacing: -0.5px;
    line-height: 1;
  }

  .comp-columns-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .comp-col-card {
    padding: 1rem 0.75rem;
    background: #FAF7F2;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    border: 1px solid transparent;
  }

  .comp-col-card--highlight {
    background: #FFFDF9;
    border-color: rgba(217, 93, 36, 0.25);
  }

  .comp-col-subtitle {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--text-muted, #71717A);
    text-transform: uppercase;
    font-weight: 700;
  }

  .comp-col-price {
    font-family: var(--font-sans);
    font-size: 1.45rem;
    font-weight: 900;
    color: var(--text-main, #18181B);
    line-height: 1.1;
    margin: 2px 0;
  }

  .comp-col-price--best {
    color: var(--accent-terracotta, #D95D24);
  }

  .comp-col-duration {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--text-muted, #71717A);
    font-weight: 600;
  }

  .transport-terracotta-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: var(--accent-terracotta, #D95D24);
    color: #FFFFFF !important;
    text-decoration: none !important;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 0.95rem;
    padding: 0.95rem 1.4rem;
    border-radius: 8px;
    width: 100%;
    box-sizing: border-box;
    transition: all 0.2s ease;
    box-shadow: 0 4px 14px rgba(217, 93, 36, 0.35);
  }

  .transport-terracotta-button:hover {
    background: var(--accent-terracotta-hover, #B84A18);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(217, 93, 36, 0.45);
  }

  .btn-arrow {
    transition: transform 0.2s ease;
  }

  .transport-terracotta-button:hover .btn-arrow {
    transform: translateX(4px);
  }

  .transport-disclaimer-row {
    text-align: center;
    margin-top: 0.85rem;
  }

  .transport-disclaimer-row small {
    font-size: 0.68rem;
    color: var(--text-muted, #71717A);
  }
</style>
