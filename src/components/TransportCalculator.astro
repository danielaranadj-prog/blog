---
/**
 * Componente: TransportCalculator.astro
 * Micro-herramienta interactiva: "¿Tren de Alta Velocidad o Avión Puerta a Puerta?"
 * Retiene al lector de 2 a 4 minutos y dirige el clic hacia el enlace de afiliado ganador.
 */
import settings from "../data/site-settings.json";

const catalog = settings.catalog || [];
const trainItem = catalog.find((i: any) => i.enabled && i.confirmed && i.type === "affiliate" && i.category === "transport");
const transferItem = catalog.find((i: any) => i.enabled && i.confirmed && i.type === "affiliate" && i.category === "activity");
---

<section class="calc-tool-card" id="calculadora-transporte" aria-label="Calculadora interactiva Tren vs Avión">
  <div class="calc-header">
    <span class="calc-badge">⚡ HERRAMIENTA INTERACTIVA DE AHORRO</span>
    <h3 class="calc-title">Calculadora Real: ¿Tren de Alta Velocidad o Avión?</h3>
    <p class="calc-subtitle">
      Las aerolíneas te muestran solo el tiempo en el aire, pero ocultan los suplementos de maleta, el traslado al aeropuerto y las 2 horas de espera en control de seguridad. Calcula tu viaje real puerta a puerta:
    </p>
  </div>

  <!-- CONTROLES INTERACTIVOS -->
  <div class="calc-controls-grid">
    <div class="calc-control-group">
      <label for="calcRouteSelect">1. Elige tu ruta</label>
      <select id="calcRouteSelect" class="calc-select">
        <option value="mad-bcn" selected>Madrid ↔ Barcelona (620 km)</option>
        <option value="mad-vlc">Madrid ↔ Valencia (360 km)</option>
        <option value="mad-svq">Madrid ↔ Sevilla (470 km)</option>
        <option value="bru-bgs">Bruselas ↔ Brujas (100 km)</option>
      </select>
    </div>

    <div class="calc-control-group">
      <label for="calcPaxRange">2. Viajeros: <strong id="calcPaxValue">2 personas</strong></label>
      <input type="range" id="calcPaxRange" min="1" max="6" value="2" class="calc-slider" />
    </div>

    <div class="calc-control-group">
      <label for="calcBagSelect">3. Equipaje por persona</label>
      <select id="calcBagSelect" class="calc-select">
        <option value="light">Solo mochila bajo asiento (0€)</option>
        <option value="cabin" selected>Maleta de cabina 10kg (+5€ tren / +24€ avión)</option>
        <option value="checked">Maleta grande 20kg (+15€ tren / +42€ avión)</option>
      </select>
    </div>

    <div class="calc-control-group">
      <label for="calcTransferSelect">4. Cómo vas al aeropuerto</label>
      <select id="calcTransferSelect" class="calc-select">
        <option value="public" selected>Transporte público (Metro / Aerobús)</option>
        <option value="taxi">Taxi tarifa fija / Uber (33€ - 40€ por trayecto)</option>
      </select>
    </div>
  </div>

  <!-- RESULTADOS COMPARATIVOS EN VIVO -->
  <div class="calc-results-grid">
    <!-- TARJETA TREN (GANADOR) -->
    <div class="calc-result-card calc-winner-card">
      <span class="winner-pill">🏆 GANADOR EN TIEMPO Y PRECIO</span>
      <div class="result-card-top">
        <span class="mode-Title">🚄 Tren Alta Velocidad (OUIGO / Iryo / Renfe)</span>
        <div class="price-big" id="trainTotalPrice">36€</div>
        <span class="price-sub" id="trainPerPersonNote">Total para 2 viajeros (traslados incluidos)</span>
      </div>

      <ul class="result-metrics-list">
        <li>⏱️ <strong>Tiempo real centro a centro:</strong> <span id="trainTotalTime">3h 15m</span></li>
        <li>🧳 <strong>Suplemento equipaje:</strong> <span id="trainBagFee">10€ total</span></li>
        <li>🚇 <strong>Traslado a estación:</strong> <span>En el centro (Atocha / Sants)</span></li>
        <li>🌱 <strong>Huella de CO₂:</strong> <span>14 kg (84% menos emisiones)</span></li>
      </ul>

      {trainItem && (
        <a
          href={trainItem.url}
          target="_blank"
          rel="sponsored nofollow noopener"
          class="calc-cta-btn calc-cta-primary"
          data-track="affiliate_click"
          data-catalog-id={trainItem.id}
        >
          {trainItem.button || "Buscar billetes desde 9€"} →
        </a>
      )}
    </div>

    <!-- TARJETA AVIÓN -->
    <div class="calc-result-card">
      <span class="loser-pill" id="planeWarningTag">⚠️ +1h 55m más lento puerta a puerta</span>
      <div class="result-card-top">
        <span class="mode-Title">✈️ Avión Low-Cost / Línea Regular</span>
        <div class="price-big price-muted" id="planeTotalPrice">156€</div>
        <span class="price-sub" id="planePerPersonNote">Total con maletas y traslados al aeropuerto</span>
      </div>

      <ul class="result-metrics-list">
        <li>⏱️ <strong>Tiempo real puerta a puerta:</strong> <span id="planeTotalTime">4h 55m</span></li>
        <li>🧳 <strong>Suplemento equipaje:</strong> <span id="planeBagFee">48€ total</span></li>
        <li>🚕 <strong>Traslado a ambos aeropuertos:</strong> <span id="planeTransferFee">30€ total</span></li>
        <li>⏳ <strong>Tiempo muerto en control y embarque:</strong> <span>2h 15m</span></li>
      </ul>

      {transferItem && (
        <a
          href={transferItem.url}
          target="_blank"
          rel="sponsored nofollow noopener"
          class="calc-cta-btn calc-cta-secondary"
          data-track="affiliate_click"
          data-catalog-id={transferItem.id}
        >
          {transferItem.button || "¿Ya tienes vuelo? Reserva traslado privado"} →
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .calc-tool-card {
    margin: 2.75rem 0;
    padding: 2rem;
    background: #FFFFFF;
    border: 2px solid #18181B;
    border-radius: 18px;
    box-shadow: 0 8px 28px rgba(24, 24, 27, 0.07);
  }

  .calc-badge {
    display: inline-block;
    background: #FFF3ED;
    color: #E04F16;
    border: 1px solid #FDBA9C;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 0.75rem;
  }

  .calc-title {
    font-family: var(--font-serif, "Playfair Display", serif);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 900;
    margin: 0 0 0.5rem !important;
    color: #18181B;
  }

  .calc-subtitle {
    font-size: 0.92rem;
    color: #52525B;
    line-height: 1.6;
    margin: 0 0 1.5rem !important;
  }

  .calc-controls-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    background: #FAF7F2;
    padding: 1.25rem;
    border-radius: 14px;
    border: 1px solid #E6E1D6;
    margin-bottom: 1.75rem;
  }

  @media (min-width: 680px) {
    .calc-controls-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .calc-control-group label {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    color: #18181B;
    margin-bottom: 0.4rem;
  }

  .calc-select {
    width: 100%;
    padding: 0.65rem 0.85rem;
    border: 1.5px solid #D6D1C4;
    border-radius: 8px;
    background: #FFFFFF;
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    color: #18181B;
  }

  .calc-slider {
    width: 100%;
    accent-color: #E04F16;
    cursor: pointer;
  }

  .calc-results-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 740px) {
    .calc-results-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .calc-result-card {
    padding: 1.5rem;
    border-radius: 14px;
    border: 1.5px solid #E6E1D6;
    background: #FAF7F2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
  }

  .calc-winner-card {
    background: #FFFFFF;
    border: 2px solid #16A34A;
    box-shadow: 0 8px 24px rgba(22, 163, 74, 0.1);
  }

  .winner-pill,
  .loser-pill {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.68rem;
    font-weight: 800;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    margin-bottom: 0.85rem;
  }

  .winner-pill {
    background: #DCFCE7;
    color: #15803D;
  }

  .loser-pill {
    background: #FEF3C7;
    color: #B45309;
  }

  .mode-Title {
    display: block;
    font-size: 0.85rem;
    font-weight: 800;
    color: #18181B;
    margin-bottom: 0.35rem;
  }

  .price-big {
    font-family: var(--font-serif, "Playfair Display", serif);
    font-size: 2.5rem;
    font-weight: 900;
    color: #15803D;
    line-height: 1;
  }

  .price-muted {
    color: #18181B;
  }

  .price-sub {
    display: block;
    font-size: 0.74rem;
    color: #71717A;
    margin-top: 0.3rem;
  }

  .result-metrics-list {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-size: 0.82rem;
    color: #27272A;
  }

  .calc-cta-btn {
    display: block;
    text-align: center;
    padding: 0.85rem 1rem;
    border-radius: 10px;
    font-size: 0.85rem;
    font-weight: 800;
    text-decoration: none !important;
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .calc-cta-primary {
    background: #E04F16;
    color: #FFFFFF !important;
    border: 1.5px solid #18181B;
  }

  .calc-cta-primary:hover {
    background: #C23E0B;
    transform: translateY(-1px);
  }

  .calc-cta-secondary {
    background: #18181B;
    color: #FFFFFF !important;
  }
</style>

<script>
  const ROUTES: Record<
    string,
    {
      trainBase: number;
      planeBase: number;
      trainMins: number;
      planeFlightMins: number;
      publicTransferPerPax: number;
      taxiFlatBothEnds: number;
    }
  > = {
    "mad-bcn": {
      trainBase: 9,
      planeBase: 39,
      trainMins: 150,
      planeFlightMins: 75,
      publicTransferPerPax: 15,
      taxiFlatBothEnds: 68,
    },
    "mad-vlc": {
      trainBase: 9,
      planeBase: 45,
      trainMins: 110,
      planeFlightMins: 65,
      publicTransferPerPax: 11,
      taxiFlatBothEnds: 58,
    },
    "mad-svq": {
      trainBase: 14,
      planeBase: 42,
      trainMins: 160,
      planeFlightMins: 70,
      publicTransferPerPax: 10,
      taxiFlatBothEnds: 60,
    },
    "bru-bgs": {
      trainBase: 8,
      planeBase: 65,
      trainMins: 58,
      planeFlightMins: 180,
      publicTransferPerPax: 16,
      taxiFlatBothEnds: 140,
    },
  };

  function formatMins(totalMins: number): string {
    const h = Math.floor(totalMins / 60);
    const m = totalMins % 60;
    return `${h}h ${m < 10 ? "0" + m : m}m`;
  }

  function recalculateTransport() {
    const routeEl = document.getElementById("calcRouteSelect") as HTMLSelectElement | null;
    const paxEl = document.getElementById("calcPaxRange") as HTMLInputElement | null;
    const bagEl = document.getElementById("calcBagSelect") as HTMLSelectElement | null;
    const transferEl = document.getElementById("calcTransferSelect") as HTMLSelectElement | null;

    if (!routeEl || !paxEl || !bagEl || !transferEl) return;

    const r = ROUTES[routeEl.value] || ROUTES["mad-bcn"];
    const pax = parseInt(paxEl.value, 10) || 2;
    const bag = bagEl.value;
    const transfer = transferEl.value;

    const paxLabel = document.getElementById("calcPaxValue");
    if (paxLabel) paxLabel.textContent = `${pax} ${pax === 1 ? "persona" : "personas"}`;

    const trainBagPerPax = bag === "light" ? 0 : bag === "cabin" ? 5 : 15;
    const planeBagPerPax = bag === "light" ? 0 : bag === "cabin" ? 24 : 42;

    const trainTransferTotal = pax * 4;
    const planeTransferTotal =
      transfer === "taxi"
        ? Math.ceil(pax / 4) * r.taxiFlatBothEnds
        : pax * r.publicTransferPerPax;

    const trainTotal = pax * (r.trainBase + trainBagPerPax) + trainTransferTotal;
    const planeTotal = pax * (r.planeBase + planeBagPerPax) + planeTransferTotal;

    const trainRealTime = r.trainMins + 45;
    const planeRealTime = r.planeFlightMins + 135 + 85;

    const diffMins = planeRealTime - trainRealTime;
    const diffMoney = planeTotal - trainTotal;

    const setTxt = (id: string, val: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = val;
    };

    setTxt("trainTotalPrice", `${trainTotal}€`);
    setTxt("trainPerPersonNote", `Total para ${pax} (${Math.round(trainTotal / pax)}€ / persona todo incluido)`);
    setTxt("trainTotalTime", formatMins(trainRealTime));
    setTxt("trainBagFee", `${pax * trainBagPerPax}€ total`);

    setTxt("planeTotalPrice", `${planeTotal}€`);
    setTxt("planePerPersonNote", `Pagas ${diffMoney}€ más en total que en tren`);
    setTxt("planeTotalTime", formatMins(planeRealTime));
    setTxt("planeBagFee", `${pax * planeBagPerPax}€ total`);
    setTxt("planeTransferFee", `${planeTransferTotal}€ total`);
    setTxt("planeWarningTag", `⚠️ Pierdes +${formatMins(diffMins)} y +${diffMoney}€`);
  }

  ["calcRouteSelect", "calcPaxRange", "calcBagSelect", "calcTransferSelect"].forEach((id) => {
    document.getElementById(id)?.addEventListener("input", recalculateTransport);
    document.getElementById(id)?.addEventListener("change", recalculateTransport);
  });

  recalculateTransport();
</script>
