---
import settings from '../data/site-settings.json';
---
{settings.ads.enabled && <div id="site-ad-preferences" data-publisher={settings.ads.publisherId} hidden><p>¿Permites cargar publicidad de Google en esta visita?</p><a href="/cookies">Ver política de cookies</a><button data-ads-accept>Permitir publicidad</button><button data-ads-decline>Ahora no</button></div>}
<script>
  if('serviceWorker' in navigator) window.addEventListener('load',()=>navigator.serviceWorker.register('/sw.js').catch(()=>{}),{once:true});
  const box=document.querySelector<HTMLElement>('#site-ad-preferences');
  const placements=[...document.querySelectorAll<HTMLElement>('[data-site-ad]')];
  if(box&&placements.length){
    let preference=null;try{preference=sessionStorage.getItem('instante-ad-consent');}catch{}
    function hideAds(){placements.forEach(frame=>frame.hidden=true);}
    function initializeAds(){
      placements.forEach(frame=>{
        if(frame.dataset?.feedVisible==='false'||frame.dataset?.adFailed==='true'){frame.hidden=true;return;}
        const slot=frame.querySelector<HTMLElement>('ins.adsbygoogle');if(!slot)return;
        if(slot.dataset.requested){frame.hidden=slot.dataset.adStatus==='unfilled';return;}
        frame.hidden=false;
        requestAnimationFrame(()=>{
          if(slot.dataset.requested)return;
          if(frame.dataset?.feedVisible==='false'||slot.getBoundingClientRect().width<(frame.dataset?.adPlacement==='feed'?250:1)){frame.hidden=true;return;}
          slot.dataset.requested='true';
          const observer=new MutationObserver(()=>{const status=slot.dataset.adStatus;if(status==='unfilled'){frame.hidden=true;observer.disconnect();}else if(status==='filled')observer.disconnect();});
          observer.observe(slot,{attributes:true,attributeFilter:['data-ad-status']});
          try{((window as any).adsbygoogle=(window as any).adsbygoogle||[]).push({});}catch{frame.hidden=true;frame.dataset.adFailed='true';observer.disconnect();}
        });
      });
    }
    function retryVisibleSlots(){const script=document.querySelector<HTMLScriptElement>('[data-ads-loader]');if(script?.dataset.loaded==='true')initializeAds();}
    window.addEventListener('instante-feed-visibility',retryVisibleSlots);
    window.addEventListener('resize',retryVisibleSlots);
    function enableAds(){
      if(!box)return;box.hidden=true;
      const existing=document.querySelector<HTMLScriptElement>('[data-ads-loader]');
      if(existing){if(existing.dataset.loaded==='true')initializeAds();return;}
      const script=document.createElement('script');script.async=true;script.crossOrigin='anonymous';script.dataset.adsLoader='true';script.src=`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${box.dataset.publisher}`;
      script.onload=()=>{script.dataset.loaded='true';initializeAds();};script.onerror=hideAds;document.head.append(script);
    }
    if(preference==='yes')enableAds();else if(preference!=='no')box.hidden=false;
    box.querySelector('[data-ads-accept]')?.addEventListener('click',()=>{try{sessionStorage.setItem('instante-ad-consent','yes');}catch{}enableAds();});
    box.querySelector('[data-ads-decline]')?.addEventListener('click',()=>{try{sessionStorage.setItem('instante-ad-consent','no');}catch{}box.hidden=true;hideAds();});
  }
</script>
<style>#site-ad-preferences{position:fixed;bottom:1rem;left:50%;transform:translateX(-50%);z-index:1100;width:min(600px,calc(100% - 2rem));padding:1rem;border:1.5px solid #18181B;border-radius:12px;background:#FAF7F2;color:#18181B;box-shadow:0 5px 20px #0002;font-size:.85rem}#site-ad-preferences button{margin:.4rem;padding:.6rem .9rem;border:1px solid #18181B;border-radius:999px;cursor:pointer}#site-ad-preferences [data-ads-accept]{background:#E04F16;color:white}</style>
