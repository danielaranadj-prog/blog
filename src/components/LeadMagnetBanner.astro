---
export interface Props {
  title?: string;
  subtitle?: string;
  leadMagnetName?: string;
  badge?: string;
  ctaText?: string;
}

const {
  title = "¿Cansado de trampas para turistas y precios inflados?",
  subtitle = "Llevamos meses recopilando en un mapa privado de Google Maps las coordenadas exactas de bares locales, miradores secretos y estaciones baratas que nunca salen en las guías patrocinadas.",
  leadMagnetName = "Mapa VIP de Google Maps: Rutas Reales & Precios Sin Filtro",
  badge = "RECURSO EXCLUSIVO // ACCESO GRATIS",
  ctaText = "Quiero el Mapa en mi Móvil"
} = Astro.props;
---

<section class="lead-magnet-banner" aria-label="Descarga recurso exclusivo">
  <div class="lead-magnet-glow"></div>
  
  <div class="lead-magnet-content">
    <div class="lead-magnet-badge">
      <span class="badge-icon">📍</span>
      <span>{badge}</span>
    </div>

    <h3 class="lead-magnet-title">{title}</h3>
    <p class="lead-magnet-desc">{subtitle}</p>

    <div class="lead-magnet-perks">
      <div class="perk-pill">✅ 45+ Puntos con coordenadas GPS</div>
      <div class="perk-pill">✅ Bares con menú local &lt; 12€</div>
      <div class="perk-pill">✅ 100% Offline en tu app de Maps</div>
    </div>

    <form class="lead-magnet-form" onsubmit="event.preventDefault(); this.querySelector('.form-success').style.display='block'; this.querySelector('.form-fields').style.display='none';">
      <div class="form-fields">
        <input 
          type="email" 
          placeholder="Tu email de viaje principal..." 
          required 
          class="lead-magnet-input"
          aria-label="Introduce tu email"
        />
        <button type="submit" class="lead-magnet-submit-btn">
          <span>{ctaText}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </div>

      <div class="form-success" style="display: none;">
        <span class="success-icon">🎉</span>
        <strong>¡Listo! Revisa tu bandeja de entrada.</strong> Te hemos enviado el link directo para sincronizar el mapa con tu cuenta de Google.
      </div>

      <p class="lead-magnet-privacy">
        🔒 Cero spam. Te enviaremos solo tips honestos de viaje. Te puedes dar de baja con un clic.
      </p>
    </form>
  </div>
</section>

<style>
  .lead-magnet-banner {
    margin: 3.5rem 0;
    padding: 2.5rem 1.75rem;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    border: 1px solid rgba(117, 170, 219, 0.3);
    border-radius: 18px;
    color: #f1f5f9;
    position: relative;
    overflow: hidden;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.25);
  }

  .lead-magnet-glow {
    position: absolute;
    top: -50px;
    right: -50px;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(117, 170, 219, 0.35) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .lead-magnet-content {
    position: relative;
    z-index: 2;
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .lead-magnet-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(244, 185, 66, 0.15);
    border: 1px solid rgba(244, 185, 66, 0.4);
    color: #F4B942;
    padding: 0.35rem 0.85rem;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.8px;
  }

  .lead-magnet-title {
    font-size: clamp(1.4rem, 3.5vw, 1.85rem);
    font-weight: 900;
    color: #ffffff;
    line-height: 1.25;
    margin: 0;
  }

  .lead-magnet-desc {
    font-size: 0.95rem;
    color: #cbd5e1;
    line-height: 1.6;
    margin: 0;
  }

  .lead-magnet-perks {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin: 0.5rem 0;
  }

  .perk-pill {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #e2e8f0;
    padding: 0.3rem 0.75rem;
    border-radius: 20px;
    font-size: 0.78rem;
    font-weight: 600;
  }

  .lead-magnet-form {
    width: 100%;
    margin-top: 0.5rem;
  }

  .form-fields {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
  }

  @media (min-width: 600px) {
    .form-fields {
      flex-direction: row;
    }
  }

  .lead-magnet-input {
    flex: 1;
    padding: 0.9rem 1.2rem;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(15, 23, 42, 0.8);
    color: #ffffff;
    font-size: 0.95rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .lead-magnet-input:focus {
    border-color: #75AADB;
    background: #0f172a;
  }

  .lead-magnet-submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #F4B942;
    color: #0b1116;
    font-weight: 800;
    font-size: 0.95rem;
    padding: 0.9rem 1.5rem;
    border-radius: 10px;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    box-shadow: 0 4px 15px rgba(244, 185, 66, 0.3);
  }

  .lead-magnet-submit-btn:hover {
    background: #e6a830;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(244, 185, 66, 0.45);
  }

  .form-success {
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.4);
    color: #a7f3d0;
    padding: 1rem 1.25rem;
    border-radius: 10px;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .success-icon {
    font-size: 1.2rem;
    margin-right: 6px;
  }

  .lead-magnet-privacy {
    margin: 0.75rem 0 0;
    font-size: 0.75rem;
    color: #94a3b8;
  }
</style>

