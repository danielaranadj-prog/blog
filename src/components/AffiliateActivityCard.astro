---
export interface Props {
  title: string;
  provider?: string;
  rating?: string;
  price?: string;
  highlights?: string[];
  imageUrl: string;
  ctaText?: string;
  ctaUrl: string;
  badge?: string;
}

const {
  title,
  provider = "Civitatis / Verificado",
  rating = "4.9 / 5 (Opiniones reales)",
  price = "Desde 15€",
  highlights = [
    "Cancelación gratuita hasta 24h antes",
    "Evita colas de hasta 2 horas en taquilla",
    "Confirmación inmediata en tu móvil"
  ],
  imageUrl,
  ctaText = "Ver Disponibilidad y Precios",
  ctaUrl,
  badge = "EXPERIENCIA TOP RECOMENDADA"
} = Astro.props;
---

<div class="affiliate-activity-card" aria-label={`Actividad recomendada: ${title}`}>
  <div class="activity-card-image-wrap">
    <img 
      src={imageUrl} 
      alt=""
      aria-hidden="true"
      loading="lazy" 
      class="activity-card-img"
    />
    <span class="activity-badge">{badge}</span>
    <span class="activity-provider-tag">{provider}</span>
  </div>

  <div class="activity-card-body">
    <div class="activity-rating-row">
      <span class="star-rating">⭐⭐⭐⭐⭐</span>
      <span class="rating-text">{rating}</span>
    </div>

    <h3 class="activity-title">{title}</h3>

    <ul class="activity-highlights">
      {highlights.map((h) => (
        <li>
          <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>{h}</span>
        </li>
      ))}
    </ul>

    <div class="activity-footer-row">
      <div class="activity-price-box">
        <span class="price-label">Precio Referencial</span>
        <strong class="price-tag">{price}</strong>
      </div>

      <a 
        href={ctaUrl} 
        target="_blank" 
        rel="sponsored nofollow noopener"
        class="activity-cta-btn"
      >
        <span>{ctaText}</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</div>

<style>
  .affiliate-activity-card {
    margin: 2.5rem 0;
    background: #ffffff;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
    display: grid;
    grid-template-columns: 1fr;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  @media (min-width: 680px) {
    .affiliate-activity-card {
      grid-template-columns: 280px 1fr;
    }
  }

  :global(.dark) .affiliate-activity-card,
  @media (prefers-color-scheme: dark) {
    .affiliate-activity-card {
      background: #1e293b;
      border-color: #334155;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
    }
  }

  .affiliate-activity-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 35px rgba(0, 0, 0, 0.1);
  }

  .activity-card-image-wrap {
    position: relative;
    height: 220px;
    overflow: hidden;
    background: #0b1116;
  }

  @media (min-width: 680px) {
    .activity-card-image-wrap {
      height: 100%;
      min-height: 220px;
    }
  }

  .activity-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .affiliate-activity-card:hover .activity-card-img {
    transform: scale(1.05);
  }

  .activity-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: #F4B942;
    color: #0b1116;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .activity-provider-tag {
    position: absolute;
    bottom: 12px;
    left: 12px;
    background: rgba(11, 17, 22, 0.85);
    color: #ffffff;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-size: 0.68rem;
    font-weight: 600;
  }

  .activity-card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
  }

  .activity-rating-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
  }

  .rating-text {
    color: var(--text-muted, #718096);
    font-weight: 600;
  }

  .activity-title {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 800;
    line-height: 1.3;
    color: var(--text-main, #2D3748);
  }

  .activity-highlights {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .activity-highlights li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--text-main, #4A5568);
    margin: 0;
  }

  .check-icon {
    flex-shrink: 0;
  }

  .activity-footer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid #E2E8F0;
  }

  :global(.dark) .activity-footer-row,
  @media (prefers-color-scheme: dark) {
    .activity-footer-row {
      border-top-color: #334155;
    }
  }

  .activity-price-box {
    display: flex;
    flex-direction: column;
  }

  .price-label {
    font-size: 0.7rem;
    color: var(--text-muted, #718096);
    text-transform: uppercase;
  }

  .price-tag {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--text-main, #2D3748);
  }

  .activity-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #F4B942;
    color: #0b1116 !important;
    text-decoration: none !important;
    font-weight: 800;
    padding: 0.75rem 1.4rem;
    border-radius: 8px;
    font-size: 0.9rem;
    transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(244, 185, 66, 0.3);
  }

  .activity-cta-btn:hover {
    background: #e6a830;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(244, 185, 66, 0.4);
  }
</style>

