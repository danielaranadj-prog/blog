---
import DesktopSideRails from './DesktopSideRails.astro';
---

<header class="editorial-header">
  <div class="header-inner">
    
    <!-- BRAND LOGO -->
    <a href="/" class="brand-link" aria-label="Instante Trips & Tips - Inicio">
      <div class="brand-logo-text">
        <span class="brand-main">INSTANTE</span>
        <span class="brand-sub">TRIPS<br/>& TIPS</span>
      </div>
    </a>

    <!-- SEARCH BAR WITH [ESC] SHORTCUT -->
    <div class="header-search-wrap">
      <div class="search-input-pill">
        <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input 
          type="text" 
          id="globalSearchInput" 
          placeholder="Buscar destinos..." 
          aria-label="Buscar destinos"
          oninput="if(typeof window.searchPosts === 'function') window.searchPosts();"
          onkeydown="if(event.key === 'Escape') { this.value = ''; if(typeof window.resetFilters === 'function') window.resetFilters(); }"
        />
        <kbd class="kbd-shortcut">[ESC]</kbd>
      </div>
    </div>

    <!-- NAVIGATION & SOCIALS -->
    <div class="header-right-group">
      <nav class="header-nav-links" aria-label="Navegación principal">
        <a href="/destinos" class="nav-item">Destinos</a>
        <a href="/#explorar" class="nav-item">Guías</a>
        <a href="/sobre-mi" class="nav-item">Sobre nosotros</a>
        <a href="/posts/madrid-traslados" class="nav-item">Contacto</a>
      </nav>

      <div class="header-social-icons">
        <a href="#" aria-label="Facebook" class="social-icon-btn">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
          </svg>
        </a>
        <a href="#" aria-label="Instagram" class="social-icon-btn">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>
        <a href="#" aria-label="X / Twitter" class="social-icon-btn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
      </div>
    </div>

  </div>
</header>

<DesktopSideRails />

<style>
  .editorial-header {
    background-color: var(--bg-page);
    border-bottom: 1px solid var(--card-border);
    padding: 1rem 0;
    position: relative;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(8px);
    background-color: rgba(250, 247, 242, 0.95);
  }

  .header-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  /* LOGO */
  .brand-link {
    text-decoration: none;
    color: var(--text-main);
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .brand-logo-text {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .brand-main {
    font-family: var(--font-serif);
    font-size: 2.3rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--text-main);
  }

  .brand-sub {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--text-muted);
    border-left: 1.5px solid var(--card-border);
    padding-left: 6px;
  }

  /* SEARCH PILL */
  .header-search-wrap {
    flex: 1;
    max-width: 320px;
    display: none;
  }

  @media (min-width: 680px) {
    .header-search-wrap {
      display: block;
    }
  }

  .search-input-pill {
    display: flex;
    align-items: center;
    background: #FFFFFF;
    border: 1px solid var(--card-border);
    border-radius: 8px;
    padding: 0.45rem 0.85rem;
    gap: 8px;
    transition: all 0.2s ease;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.02);
  }

  .search-input-pill:focus-within {
    border-color: var(--accent-terracotta);
    box-shadow: 0 0 0 3px rgba(217, 93, 36, 0.12);
  }

  .search-icon {
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .search-input-pill input {
    border: none;
    background: transparent;
    outline: none;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--text-main);
    width: 100%;
  }

  .search-input-pill input::placeholder {
    color: #A1A1AA;
  }

  .kbd-shortcut {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    color: #A1A1AA;
    background: #F4F4F5;
    border: 1px solid #E4E4E7;
    border-radius: 4px;
    padding: 0.1rem 0.35rem;
    font-weight: 700;
    pointer-events: none;
  }

  /* RIGHT GROUP */
  .header-right-group {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .header-nav-links {
    display: none;
    align-items: center;
    gap: 1.4rem;
  }

  @media (min-width: 990px) {
    .header-nav-links {
      display: flex;
    }
  }

  .nav-item {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-main);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .nav-item:hover {
    color: var(--accent-terracotta);
  }

  .header-social-icons {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .social-icon-btn {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #18181B;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .social-icon-btn:hover {
    background-color: var(--accent-terracotta);
    transform: translateY(-2px);
  }

  @media (max-width: 1199px) {
    .header-inner { flex-wrap: wrap; gap: 1rem; }
    .header-right-group { margin-left: auto; }
    .header-nav-links { display: flex; gap: 1rem; }
    .header-social-icons { display: none; }
    .brand-main { font-size: 1.9rem; }
    .header-search-wrap { max-width: 260px; }
  }
  @media (max-width: 699px) {
    .header-inner { padding: 0 1rem; gap: .85rem; }
    .brand-main { font-size: 1.8rem; }
    .header-search-wrap { display: block; max-width: none; flex: 0 0 100%; order: 3; }
    .search-input-pill input { font-size: 1rem; min-height: 28px; }
    .header-right-group { flex: 0 0 100%; order: 2; margin: 0; }
    .header-nav-links { width: 100%; justify-content: space-between; gap: .5rem; }
    .nav-item { font-size: .72rem; min-height: 32px; display: inline-flex; align-items: center; }
    .kbd-shortcut { display: none; }
  }
</style>