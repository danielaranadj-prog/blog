---
import settings from '../data/site-settings.json';
import SiteSocialLinks from './SiteSocialLinks.astro';
---

<header class="editorial-header">
  <div class="header-inner">
    
    <!-- BRAND LOGO -->
    <a href="/" class="brand-link" aria-label={`${settings.name} - Inicio`}>
      {settings.assets.logo ? <img class="site-brand-image" src={settings.assets.logo} alt={settings.name} width="230" height="48" /> : <div class="brand-logo-text"><span class="brand-main">{settings.brandTitle}</span><span class="brand-sub">{settings.brandSubtitle}</span></div>}
    </a>

    <!-- SEARCH BAR WITH [ESC] SHORTCUT -->
    <div class="header-search-wrap">
      <div class="search-input-pill">
        <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input 
          type="text" 
          id="globalSearchInput" 
          placeholder="Buscar destinos..." 
          aria-label="Buscar destinos"
          oninput="if(typeof window.searchPosts === 'function') window.searchPosts();"
          onkeydown="if(event.key === 'Escape') { this.value = ''; if(typeof window.resetFilters === 'function') window.resetFilters(); }"
        />
        <kbd class="kbd-shortcut">[ESC]</kbd>
      </div>
    </div>

    <!-- NAVIGATION & SOCIALS -->
    <div class="header-right-group">
      <nav class="header-nav-links" aria-label="Navegación principal">
        {settings.navigation.filter(link => link.enabled).map(link => <a href={link.url} class="nav-item">{link.label}</a>)}
      </nav>

      <div class="header-social-icons"><SiteSocialLinks />
      </div>
    </div>

  </div>
</header>

<style>
.site-brand-image {display:block;max-width:230px;width:auto;max-height:48px;object-fit:contain;}
.brand-sub {max-width:80px;}

  .editorial-header {
    background-color: var(--bg-page);
    border-bottom: 1px solid var(--card-border);
    padding: 1rem 0;
    position: relative;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(8px);
    background-color: rgba(250, 247, 242, 0.95);
  }

  .header-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  /* LOGO */
  .brand-link {
    text-decoration: none;
    color: var(--text-main);
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .brand-logo-text {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .brand-main {
    font-family: var(--font-serif);
    font-size: 2.3rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--text-main);
  }

  .brand-sub {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--text-muted);
    border-left: 1.5px solid var(--card-border);
    padding-left: 6px;
  }

  /* SEARCH PILL */
  .header-search-wrap {
    flex: 1;
    max-width: 320px;
    display: none;
  }

  @media (min-width: 680px) {
    .header-search-wrap {
      display: block;
    }
  }

  .search-input-pill {
    display: flex;
    align-items: center;
    background: #FFFFFF;
    border: 1px solid var(--card-border);
    border-radius: 8px;
    padding: 0.45rem 0.85rem;
    gap: 8px;
    transition: all 0.2s ease;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.02);
  }

  .search-input-pill:focus-within {
    border-color: var(--accent-terracotta);
    box-shadow: 0 0 0 3px rgba(217, 93, 36, 0.12);
  }

  .search-icon {
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .search-input-pill input {
    border: none;
    background: transparent;
    outline: none;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--text-main);
    width: 100%;
  }

  .search-input-pill input::placeholder {
    color: #A1A1AA;
  }

  .kbd-shortcut {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    color: #A1A1AA;
    background: #F4F4F5;
    border: 1px solid #E4E4E7;
    border-radius: 4px;
    padding: 0.1rem 0.35rem;
    font-weight: 700;
    pointer-events: none;
  }

  /* RIGHT GROUP */
  .header-right-group {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .header-nav-links {
    display: none;
    align-items: center;
    gap: 1.4rem;
  }

  @media (min-width: 990px) {
    .header-nav-links {
      display: flex;
    }
  }

  .nav-item {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-main);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .nav-item:hover {
    color: var(--accent-terracotta);
  }

  .header-social-icons {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .social-icon-btn {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #18181B;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .social-icon-btn:hover {
    background-color: var(--accent-terracotta);
    transform: translateY(-2px);
  }

  @media (max-width: 1199px) {
    .header-inner { flex-wrap: wrap; gap: 1rem; }
    .header-right-group { margin-left: auto; }
    .header-nav-links { display: flex; gap: 1rem; }
    .header-social-icons { display: none; }
    .brand-main { font-size: 1.9rem; }
    .header-search-wrap { max-width: 260px; }
  }
  @media (max-width: 699px) {
    .header-inner { padding: 0 1rem; gap: .85rem; }
    .brand-main { font-size: 1.8rem; }
    .header-search-wrap { display: block; max-width: none; flex: 0 0 100%; order: 3; }
    .search-input-pill input { font-size: 1rem; min-height: 28px; }
    .header-right-group { flex: 0 0 100%; order: 2; margin: 0; }
    .header-nav-links { width: 100%; justify-content: space-between; gap: .5rem; }
    .nav-item { font-size: .72rem; min-height: 32px; display: inline-flex; align-items: center; }
    .kbd-shortcut { display: none; }
  }
</style>