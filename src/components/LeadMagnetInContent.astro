---
import settings from '../data/site-settings.json';
import {getNewsletterUrl} from '../utils/newsletter.mjs';
import TravelIcon from './TravelIcon.astro';
const url=getNewsletterUrl(settings.audience?.newsletterUrl);
---
{url&&<aside class="travel-newsletter"><div><span class="travel-kicker">El viaje continúa</span><h3>{settings.audience.newsletterTitle||'Recibe las próximas historias'}</h3><p>{settings.audience.newsletterText}</p></div><a class="travel-button travel-button-primary" href={url} target="_blank" rel="noopener"><TravelIcon name="mail"/>Ir al formulario de suscripción ↗</a><small>La suscripción se completa en el proveedor de correo.</small></aside>}
<style>.travel-newsletter{border:1.5px solid var(--text-main);background:var(--surface-muted);border-radius:14px;padding:1.75rem;margin:2rem 0}.travel-newsletter h3{font:800 1.7rem/1.2 var(--font-serif);margin:.5rem 0 .8rem}.travel-newsletter p{font-size:.85rem;line-height:1.8;margin:0 0 1.25rem}.travel-newsletter small{display:block;font-size:.68rem;color:var(--text-secondary);margin-top:.75rem}</style>
