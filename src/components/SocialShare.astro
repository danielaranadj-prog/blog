---
interface Props { title: string; url: string; shortUrl?: string; compact?: boolean; }
const {title,url,shortUrl,compact=false}=Astro.props;
const shareTarget=shortUrl||url;
const encodedUrl=encodeURIComponent(shareTarget);
const whatsappText=encodeURIComponent(`${title}\n${shareTarget}`);
---
<section class:list={['social-share',{'compact':compact}]} aria-label="Compartir artículo">
  <div class="share-heading"><span>COMPARTE EL VIAJE</span>{!compact&&<h2>¿A quién le vendría bien esta guía?</h2>}</div>
  <div class="share-buttons">
    <a href={`https://wa.me/?text=${whatsappText}`} target="_blank" rel="noopener noreferrer" class="share-btn" aria-label="Compartir en WhatsApp"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
      </svg><span>WhatsApp</span></a>
    <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`} target="_blank" rel="noopener noreferrer" class="share-btn" aria-label="Compartir en Facebook"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
      </svg><span>Facebook</span></a>
    <button type="button" class="share-btn copy-link" data-url={shareTarget} aria-label="Copiar link corto"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
      </svg><span data-copy-label>Copiar link corto</span></button>
  </div>
  <p class="share-status" role="status" aria-live="polite"></p>
  <label class="copy-fallback" hidden>Selecciona y copia el enlace corto<input type="url" value={shareTarget} readonly aria-label="Enlace corto del artículo"/></label>
</section>
<script>
  function initSocialShare(){
    document.querySelectorAll<HTMLButtonElement>('.social-share .copy-link').forEach(button=>{
      if(button.dataset.bound)return;button.dataset.bound='true';
      button.addEventListener('click',async()=>{
        const url=button.dataset.url;if(!url)return;
        const group=button.closest('.social-share')!;
        const status=group.querySelector<HTMLElement>('.share-status')!;
        const label=button.querySelector<HTMLElement>('[data-copy-label]')!;
        const fallback=group.querySelector<HTMLElement>('.copy-fallback')!;
        button.disabled=true;
        try{
          await navigator.clipboard.writeText(url);
          fallback.hidden=true;label.textContent='¡Link corto copiado!';status.textContent=`Link corto copiado: ${url}`;
          button.classList.add('copied');
          setTimeout(()=>{label.textContent='Copiar link corto';status.textContent='';button.classList.remove('copied');},2500);
        }catch{
          status.textContent='No se pudo copiar automáticamente. Puedes copiarlo desde este campo.';
          fallback.hidden=false;const input=fallback.querySelector('input')!;input.focus();input.select();
        }finally{button.disabled=false;}
      });
    });
  }
  initSocialShare();document.addEventListener('astro:page-load',initSocialShare);
</script>
<style>
.social-share{border:1.5px solid #18181B;border-radius:14px;background:#F3EFE6;padding:1.4rem;margin:2rem 0;box-shadow:0 4px 0 #18181b0d;color:#18181B}.share-heading>span{font:800 .6rem/1.5 var(--font-sans);letter-spacing:.14em;color:#736D64}.share-heading h2{font:700 clamp(1.3rem,2vw,1.7rem)/1.25 var(--font-serif);letter-spacing:-.02em;margin:.45rem 0 1rem;color:#18181B}.share-buttons{display:flex;flex-wrap:wrap;gap:.6rem}.share-btn{display:inline-flex;align-items:center;justify-content:center;gap:.55rem;min-height:44px;padding:.65rem 1rem;border:1.5px solid #18181B;border-radius:999px;background:#FAF7F2;color:#18181B;font:700 .75rem/1.3 var(--font-sans);text-decoration:none;cursor:pointer;transition:background .15s,color .15s}.share-btn svg{width:17px;height:17px;flex-shrink:0}.share-btn:hover,.share-btn.copied{background:var(--accent-terracotta,#E04F16);color:#fff}.share-btn:focus-visible,.copy-fallback input:focus-visible{outline:3px solid var(--accent-terracotta,#E04F16);outline-offset:4px}.share-btn:disabled{opacity:.6;cursor:wait}.share-status{font:500 .75rem/1.6 var(--font-sans);margin:.7rem 0 0;color:#736D64}.share-status:empty{display:none}.copy-fallback{display:block;margin-top:1rem;font:600 .75rem var(--font-sans)}.copy-fallback[hidden]{display:none}.copy-fallback input{box-sizing:border-box;display:block;width:100%;min-width:0;margin-top:.5rem;padding:.7rem;border:1px solid #736D64;border-radius:8px;font:inherit;color:#18181B;background:#FAF7F2}.compact{display:flex;flex-wrap:wrap;align-items:center;gap:.65rem 1rem;background:transparent;border:0;border-radius:0;box-shadow:none;margin:1rem 0 0;padding:0}.compact .share-status,.compact .copy-fallback{flex-basis:100%;margin:0}.compact .share-btn{padding:.55rem .8rem}.compact .share-heading{flex-shrink:0}@media(max-width:520px){.social-share:not(.compact){padding:1.1rem}.share-buttons{width:100%;gap:.45rem}.share-btn{flex:1 1 auto;padding:.65rem .7rem;font-size:.7rem;gap:.4rem}.compact{gap:.5rem}.compact .share-btn{padding:.55rem .65rem}.compact .share-heading>span{font-size:.58rem}}
</style>
