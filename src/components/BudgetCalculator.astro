---
/**
 * Componente: BudgetCalculator.astro
 * Micro-herramienta interactiva: "Calculadora de Presupuesto Diario de Viaje (Sin Trampas de Turista)"
 * Ideal para la página /recursos/ y guías de varios días (Buenos Aires, Madrid, Barcelona, Ushuaia).
 */
import { buildAffiliateUrl, AFFILIATE_CONFIG } from "../config/affiliates";

const civitatisMadridUrl = buildAffiliateUrl("https://www.civitatis.com/es/madrid/", "budget-calc");
---

<section class="budget-calc-card" id="calculadora-presupuesto" aria-label="Calculadora de presupuesto de viaje">
  <div class="budget-header">
    <span class="budget-eyebrow">💰 PLANIFICADOR HONESTO DE PRESUPUESTO</span>
    <h3 class="budget-title">¿Cuánto cuesta realmente viajar sin que te sangren?</h3>
    <p class="budget-desc">
      Selecciona tu destino, cuántos días viajas y tu estilo. Calculamos el gasto real diario evitando restaurantes trampa para turistas.
    </p>
  </div>

  <div class="budget-inputs-row">
    <div class="budget-field">
      <label for="budgetDestSelect">Destino</label>
      <select id="budgetDestSelect" class="budget-input">
        <option value="madrid" selected>🇪🇸 Madrid, España</option>
        <option value="barcelona">🇪🇸 Barcelona, España</option>
        <option value="baires">🇦🇷 Buenos Aires, Argentina</option>
        <option value="ushuaia">🇦🇷 Ushuaia (Fin del Mundo)</option>
        <option value="brujas">🇧🇪 Bruselas y Brujas, Bélgica</option>
      </select>
    </div>

    <div class="budget-field">
      <label for="budgetDaysRange">Duración: <strong id="budgetDaysVal">5 días</strong></label>
      <input type="range" id="budgetDaysRange" min="1" max="15" value="5" class="budget-range" />
    </div>

    <div class="budget-field">
      <label for="budgetStyleSelect">Estilo de Viaje</label>
      <select id="budgetStyleSelect" class="budget-input">
        <option value="backpacker">🎒 Mochilero / Supervivencia (Hostel y menú local)</option>
        <option value="realist" selected>✨ Viajero Inteligente (Hotel céntrico + tabernas reales)</option>
        <option value="comfort">🍷 Confort sin excesos (Boutique + experiencias top)</option>
      </select>
    </div>
  </div>

  <div class="budget-summary-panel">
    <div class="budget-total-col">
      <span class="total-label">PRESUPUESTO TOTAL ESTIMADO POR PERSONA</span>
      <div class="total-amount-eur" id="budgetTotalEur">420€</div>
      <span class="total-amount-usd" id="budgetTotalUsd">≈ $454 USD en total (<span id="budgetPerDayEur">84€</span> / día)</span>
      <p class="destination-pro-tip" id="budgetProTip">
        💡 <strong>Tip de ahorro en Madrid:</strong> Pide siempre "Menú del Día" a mediodía (14€-16€ con bebida y postre) y usa el tren C-1 desde la T4 (2,60€).
      </p>
    </div>

    <div class="budget-breakdown-col">
      <div class="breakdown-item">
        <span>🏨 Alojamiento bien ubicado</span>
        <strong id="breakStay">210€</strong>
      </div>
      <div class="breakdown-item">
        <span>🍽️ Comida real (sin trampas turísticas)</span>
        <strong id="breakFood">120€</strong>
      </div>
      <div class="breakdown-item">
        <span>🚇 Transporte urbano y traslados</span>
        <strong id="breakTransport">30€</strong>
      </div>
      <div class="breakdown-item">
        <span>🎟️ Entradas, museos y free tours</span>
        <strong id="breakActivities">60€</strong>
      </div>

      <div class="budget-cta-group">
        <a
          href={civitatisMadridUrl}
          id="budgetActivitiesCta"
          target="_blank"
          rel="sponsored nofollow noopener"
          class="budget-btn-primary"
          data-track="affiliate_click"
        >
          Reservar Free Tours y Entradas Oficiales →
        </a>
        <a
          href={AFFILIATE_CONFIG.insurance.affiliateUrl}
          target="_blank"
          rel="sponsored nofollow noopener"
          class="budget-btn-secondary"
          data-track="affiliate_click"
        >
          Añadir Seguro de Viaje (-5% dto) →
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .budget-calc-card {
    margin: 2.5rem 0;
    padding: 2rem;
    background: #FAF7F2;
    border: 1.5px solid #18181B;
    border-radius: 18px;
  }

  .budget-eyebrow {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #E04F16;
    display: block;
    margin-bottom: 0.4rem;
  }

  .budget-title {
    font-family: var(--font-serif, "Playfair Display", serif);
    font-size: clamp(1.4rem, 2.4vw, 1.85rem);
    font-weight: 900;
    margin: 0 0 0.5rem !important;
    color: #18181B;
  }

  .budget-desc {
    font-size: 0.9rem;
    color: #52525B;
    margin: 0 0 1.5rem !important;
  }

  .budget-inputs-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 720px) {
    .budget-inputs-row {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .budget-field label {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
    color: #18181B;
  }

  .budget-input {
    width: 100%;
    padding: 0.65rem 0.8rem;
    border-radius: 8px;
    border: 1.5px solid #D6D1C4;
    background: #FFFFFF;
    font-family: inherit;
    font-size: 0.84rem;
    font-weight: 600;
  }

  .budget-range {
    width: 100%;
    accent-color: #E04F16;
  }

  .budget-summary-panel {
    background: #FFFFFF;
    border: 1.5px solid #E6E1D6;
    border-radius: 14px;
    padding: 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: center;
  }

  @media (min-width: 720px) {
    .budget-summary-panel {
      grid-template-columns: 1.05fr 1fr;
    }
  }

  .total-label {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #71717A;
    display: block;
  }

  .total-amount-eur {
    font-family: var(--font-serif, "Playfair Display", serif);
    font-size: 3rem;
    font-weight: 900;
    color: #18181B;
    line-height: 1.05;
    margin: 0.2rem 0;
  }

  .total-amount-usd {
    font-size: 0.84rem;
    font-weight: 700;
    color: #E04F16;
    display: block;
    margin-bottom: 1rem;
  }

  .destination-pro-tip {
    background: #FFF8F1;
    border-left: 3px solid #E04F16;
    padding: 0.75rem 1rem;
    font-size: 0.8rem !important;
    line-height: 1.5 !important;
    margin: 0 !important;
    border-radius: 0 8px 8px 0;
  }

  .breakdown-item {
    display: flex;
    justify-content: space-between;
    padding: 0.55rem 0;
    border-bottom: 1px dashed #E6E1D6;
    font-size: 0.84rem;
  }

  .budget-cta-group {
    margin-top: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .budget-btn-primary,
  .budget-btn-secondary {
    display: block;
    text-align: center;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 800;
    text-decoration: none !important;
  }

  .budget-btn-primary {
    background: #E04F16;
    color: #FFFFFF !important;
  }

  .budget-btn-secondary {
    background: #18181B;
    color: #FFFFFF !important;
  }
</style>

<script>
  const DEST_DATA: Record<
    string,
    {
      stay: number;
      food: number;
      transport: number;
      activities: number;
      tip: string;
      civitatisSlug: string;
    }
  > = {
    madrid: {
      stay: 42,
      food: 24,
      transport: 6,
      activities: 12,
      tip: '💡 <strong>Tip de ahorro en Madrid:</strong> Pide "Menú del Día" a mediodía (14€-16€ completo) y sal de la T4 en el tren C-1 por solo 2,60€.',
      civitatisSlug: "https://www.civitatis.com/es/madrid/?aid=104521",
    },
    barcelona: {
      stay: 48,
      food: 26,
      transport: 7,
      activities: 15,
      tip: "💡 <strong>Tip de ahorro en Barcelona:</strong> Nunca comas en Las Ramblas; camina 3 calles hacia El Born o Gràcia y ahorra un 45%.",
      civitatisSlug: "https://www.civitatis.com/es/barcelona/?aid=104521",
    },
    baires: {
      stay: 25,
      food: 16,
      transport: 3,
      activities: 8,
      tip: "💡 <strong>Tip de ahorro en Buenos Aires:</strong> Compra la tarjeta SUBE el primer día y usa efectivo cambiado a tasa MEP/Blue en parrillas de barrio.",
      civitatisSlug: "https://www.civitatis.com/es/buenos-aires/?aid=104521",
    },
    ushuaia: {
      stay: 38,
      food: 22,
      transport: 8,
      activities: 25,
      tip: "💡 <strong>Tip de ahorro en Ushuaia:</strong> Reserva la navegación por el Canal Beagle con antelación y lleva ropa térmica propia para no alquilar a sobreprecio.",
      civitatisSlug: "https://www.civitatis.com/es/ushuaia/?aid=104521",
    },
    brujas: {
      stay: 46,
      food: 28,
      transport: 9,
      activities: 11,
      tip: "💡 <strong>Tip de ahorro en Bélgica:</strong> Si viajas en sábado o domingo entre Bruselas y Brujas, pide el Weekend Ticket de SNCB y paga exactamente la mitad (50% dto).",
      civitatisSlug: "https://www.civitatis.com/es/brujas/?aid=104521",
    },
  };

  const STYLE_MULTIPLIER: Record<string, number> = {
    backpacker: 0.65,
    realist: 1.0,
    comfort: 1.65,
  };

  function updateBudgetCalc() {
    const destEl = document.getElementById("budgetDestSelect") as HTMLSelectElement | null;
    const daysEl = document.getElementById("budgetDaysRange") as HTMLInputElement | null;
    const styleEl = document.getElementById("budgetStyleSelect") as HTMLSelectElement | null;

    if (!destEl || !daysEl || !styleEl) return;

    const d = DEST_DATA[destEl.value] || DEST_DATA.madrid;
    const days = parseInt(daysEl.value, 10) || 5;
    const mult = STYLE_MULTIPLIER[styleEl.value] || 1.0;

    const daysValEl = document.getElementById("budgetDaysVal");
    if (daysValEl) daysValEl.textContent = `${days} ${days === 1 ? "día" : "días"}`;

    const stayTotal = Math.round(d.stay * mult * days);
    const foodTotal = Math.round(d.food * mult * days);
    const transTotal = Math.round(d.transport * days);
    const actTotal = Math.round(d.activities * mult * days);

    const grandTotalEur = stayTotal + foodTotal + transTotal + actTotal;
    const grandTotalUsd = Math.round(grandTotalEur * 1.08);
    const perDayEur = Math.round(grandTotalEur / days);

    const setEl = (id: string, val: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = val;
    };

    setEl("budgetTotalEur", `${grandTotalEur}€`);
    setEl("budgetTotalUsd", `≈ $${grandTotalUsd} USD en total (${perDayEur}€ / día)`);
    setEl("breakStay", `${stayTotal}€`);
    setEl("breakFood", `${foodTotal}€`);
    setEl("breakTransport", `${transTotal}€`);
    setEl("breakActivities", `${actTotal}€`);

    const tipEl = document.getElementById("budgetProTip");
    if (tipEl) tipEl.innerHTML = d.tip;

    const ctaEl = document.getElementById("budgetActivitiesCta") as HTMLAnchorElement | null;
    if (ctaEl) ctaEl.href = d.civitatisSlug;
  }

  ["budgetDestSelect", "budgetDaysRange", "budgetStyleSelect"].forEach((id) => {
    document.getElementById(id)?.addEventListener("input", updateBudgetCalc);
    document.getElementById(id)?.addEventListener("change", updateBudgetCalc);
  });

  updateBudgetCalc();
</script>
