---
export interface Props {
	post: any;
}

const { post } = Astro.props;

// Imagen de portada
const portada = post.frontmatter.heroImage || post.frontmatter.heroImageLink;

// Tags y Categoría
const tags = post.frontmatter.tags || [];
const mainTag = tags.length > 0 ? tags[0] : 'Viajes';
const secondTag = tags.length > 1 ? tags[1] : '';

// Presupuesto simulado/asignado editorial
const titleLower = (post.frontmatter.title || '').toLowerCase();
const budgetLevel = titleLower.includes('gratis') || titleLower.includes('barato') || titleLower.includes('mochilero')
  ? 'PRESUPUESTO: BAJO'
  : titleLower.includes('hotel') || titleLower.includes('lujo') || titleLower.includes('patagonia')
    ? 'PRESUPUESTO: ALTO'
    : 'PRESUPUESTO: MEDIO';

// Estimación de tiempo de lectura
const readingMinutes = titleLower.includes('guía') || titleLower.includes('supervivencia') ? '6 MIN' : '4 MIN';
---

<article class="editorial-post-card">
	<a href={post.url} class="card-clickable-area" aria-label={`Leer artículo: ${post.frontmatter.title}`}>
		
		<!-- IMAGE CONTAINER WITH OVERLAID PILL BADGE -->
		<div class="card-image-wrap">
			{portada ? (
				<img 
					src={portada} 
					alt="" 
					aria-hidden="true"
					loading="lazy"
					width="600"
					height="340"
					class="card-img"
				/>
			) : (
				<div class="card-placeholder-img"></div>
			)}
			<div class="card-overlaid-badge">
				<span>{mainTag.toUpperCase()}{secondTag ? ` • ${secondTag.toUpperCase()}` : ''} • {readingMinutes} LECTURA</span>
			</div>
		</div>

		<!-- CARD CONTENT -->
		<div class="card-body">
			<h3 class="card-title serif-heading">{post.frontmatter.title}</h3>

			{post.frontmatter.description && (
				<p class="card-excerpt">{post.frontmatter.description}</p>
			)}

			<div class="card-footer-row">
				<span class="budget-pill">{budgetLevel}</span>
				<span class="read-more-link">
					Leer más <span class="arrow-sym">→</span>
				</span>
			</div>
		</div>
	</a>
</article>

<style>
	.editorial-post-card {
		background-color: var(--card-bg, #FFFFFF);
		border: 1px solid var(--card-border, #E6E1D6);
		border-radius: 16px;
		overflow: hidden;
		box-shadow: var(--card-shadow, 0 4px 20px rgba(0, 0, 0, 0.04));
		transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
		display: flex;
		flex-direction: column;
		height: 100%;
		box-sizing: border-box;
	}

	.editorial-post-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--card-shadow-hover, 0 10px 30px rgba(0, 0, 0, 0.08));
		border-color: #D4CDBD;
	}

	.card-clickable-area {
		text-decoration: none;
		color: inherit;
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.card-image-wrap {
		position: relative;
		width: 100%;
		height: 155px;
		background-color: #E6E1D6;
		overflow: hidden;
		flex-shrink: 0;
	}

	.card-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		display: block;
		margin: 0 !important;
		transition: transform 0.4s ease;
	}

	.editorial-post-card:hover .card-img {
		transform: scale(1.04);
	}

	.card-placeholder-img {
		width: 100%;
		height: 100%;
		background: linear-gradient(135deg, #E6E1D6 0%, #D4CDBD 100%);
	}

	.card-overlaid-badge {
		position: absolute;
		top: 10px;
		left: 10px;
		background: rgba(255, 255, 255, 0.95);
		backdrop-filter: blur(4px);
		border: 1px solid rgba(0, 0, 0, 0.08);
		color: var(--text-main, #18181B);
		padding: 0.25rem 0.6rem;
		border-radius: 50px;
		font-size: 0.65rem;
		font-weight: 800;
		letter-spacing: 0.4px;
		text-transform: uppercase;
		box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
	}

	.card-body {
		padding: 1.15rem 1.15rem 1rem;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
		gap: 0.5rem;
		box-sizing: border-box;
	}

	.card-title {
		font-family: var(--font-serif);
		font-size: 1.05rem;
		font-weight: 800;
		color: var(--text-main, #18181B);
		line-height: 1.28;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		transition: color 0.2s ease;
	}

	.editorial-post-card:hover .card-title {
		color: var(--accent-terracotta, #D95D24);
	}

	.card-excerpt {
		font-family: var(--font-sans);
		font-size: 0.85rem;
		color: var(--text-muted, #71717A);
		line-height: 1.45;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		flex-grow: 1;
	}

	.card-footer-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-top: 0.75rem;
		border-top: 1px solid var(--card-border, #E6E1D6);
		margin-top: auto;
	}

	.budget-pill {
		font-family: var(--font-sans);
		font-size: 0.65rem;
		font-weight: 800;
		color: var(--text-main, #18181B);
		background: #FAF7F2;
		border: 1px solid var(--card-border, #E6E1D6);
		padding: 0.2rem 0.5rem;
		border-radius: 4px;
		letter-spacing: 0.4px;
	}

	.read-more-link {
		font-family: var(--font-sans);
		font-size: 0.82rem;
		font-weight: 800;
		color: var(--accent-terracotta, #D95D24);
		display: inline-flex;
		align-items: center;
		gap: 4px;
		transition: gap 0.2s ease;
	}

	.editorial-post-card:hover .read-more-link {
		gap: 7px;
	}
</style>